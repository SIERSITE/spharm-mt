# ───────────────────────────────────────────────────────────────────
# SPharm.MT local agent — .env.example
#
# Template para configurar o agent no servidor on-premise da farmácia.
#
# COMO USAR:
#   1. Copia este ficheiro para `.env` na mesma pasta:
#        copy .env.example .env       (Windows)
#        cp   .env.example .env       (Linux/Mac)
#   2. Edita o `.env` substituindo os placeholders <ASSIM> pelos
#      valores reais.
#   3. NUNCA commitar `.env` (já está no .gitignore).
#   4. NUNCA enviar o `.env` por email/Slack/Teams. Para passar a
#      ingest key, o dev usa um vault partilhado (1Password, Bitwarden)
#      ou comunica em chamada.
#
# Valores neste exemplo apontam para o tenant `demo-neon` (piloto).
# ───────────────────────────────────────────────────────────────────


# ─── SECÇÃO 1: SaaS — onde o agent envia dados ─────────────────────

# URL pública da plataforma SPharm.MT (HTTPS obrigatório).
# Sem trailing slash. Pede ao dev se não tens a certeza.
SPHARMMT_ENDPOINT="https://app.spharmmt.com"

# Slug do tenant (grupo de farmácias) — único na plataforma.
# Para o piloto actual: demo-neon
SPHARMMT_TENANT_SLUG="demo-neon"

# API key emitida pelo dev via `tenancy:issue-ingest-key`.
# 64 caracteres hexadecimais. Em todos os logs aparece mascarada
# ("a*****b"). O dev mostra-a UMA VEZ no momento da emissão.
#
# Se perdeste: pede ao dev para rodar com `--rotate` (a anterior fica
# inválida — nenhum agent antigo continuará a funcionar).
SPHARMMT_INGEST_KEY="<COLAR_KEY_64_HEX_DO_DEV>"

# Farmácia à qual este agent corresponde (1 agent = 1 farmácia, v1).
# Aceita:
#   · nome legível: "Farmácia Central"  (resolvido para cuid via API
#     na primeira chamada)
#   · cuid directo: "ckxgzps700001abcde123456"  (sem resolução)
# Para o piloto: usa o nome que criaste no tenant.
SPHARMMT_FARMACIA="Farmácia Central"


# ─── SECÇÃO 2: SQL Server local — SPharm ERP (Softreis) ────────────

# Host do SQL Server. Tipicamente:
#   · "localhost"               se o agent corre no mesmo PC do ERP
#   · "192.168.1.10"            se está em outra máquina da LAN
#   · "SERVER-PC"               nome NetBIOS dentro do AD
#   · "SERVER-PC\\SQLEXPRESS"   se for instância nomeada — NESTE CASO,
#                                põe só "SERVER-PC" aqui e a porta
#                                TCP/IP exposta abaixo. SQL Server
#                                Browser tem de estar a correr para
#                                instância nomeada via UDP, ou expor
#                                porta TCP fixa.
ERP_SQLSERVER_HOST="localhost"

# Porta TCP do SQL Server. Default 1433. Em instância nomeada com
# porta fixa, usa a porta configurada no Configuration Manager.
ERP_SQLSERVER_PORT="1433"

# Nome da database SPharm. Pergunta ao informático/responsável do ERP
# se não tens a certeza. Tipicamente "SPHARM" ou "SPHARMDB".
ERP_SQLSERVER_DATABASE="SPHARM"

# Login SQL Server DEDICADO READ-ONLY (ver agent/SECURITY.md §1).
# NUNCA usar `sa` nem o user da aplicação SPharm. Cria um login
# novo com permissão `db_datareader` apenas.
ERP_SQLSERVER_USER="spharm_readonly"

# Password do login read-only. Mascarada nos logs do agent.
# Nunca enviada para a SaaS (ver agent/SECURITY.md §3).
ERP_SQLSERVER_PASSWORD="<COLAR_PASSWORD_DO_LOGIN_READONLY>"

# TLS/SSL na conexão ao SQL Server.
#   "0" = sem TLS (típico em LAN local, server na mesma máquina)
#   "1" = liga TLS (requer SQL Server com certificado configurado)
ERP_SQLSERVER_ENCRYPT="0"

# Confiar em certificado self-signed quando ENCRYPT="1".
#   "1" = aceita self-signed (default — típico em LAN)
#   "0" = valida cadeia de certificação (raro em deployments locais)
ERP_SQLSERVER_TRUST_CERT="1"


# ─── SECÇÃO 3: Opcionais (deixar em branco usa defaults) ───────────

# Override do directório de output do discovery/sync.
# Default: agent/output/ (relativo ao próprio binário).
# Útil se preferes outputs num drive específico ou pasta partilhada.
# SPHARMMT_AGENT_OUTPUT_DIR="C:\\spharm-agent\\output"

# Versão reportada no User-Agent das chamadas ao SaaS.
# Default: 0.1.0
# SPHARMMT_AGENT_VERSION="0.1.0"
