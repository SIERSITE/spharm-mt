# ───────────────────────────────────────────────────────────────
# SPharm.MT local agent — .env.example
#
# Copia este ficheiro para `.env` no servidor on-premise da farmácia,
# preenche os valores. Nunca commitar `.env`.
# ───────────────────────────────────────────────────────────────

# ── SaaS endpoint (URL pública da plataforma SPharm.MT) ────────
SPHARMMT_ENDPOINT="https://app.spharmmt.app"

# ── Identificação do tenant (grupo de farmácias) ───────────────
# Slug do tenant — usado no header X-Tenant-Slug.
SPHARMMT_TENANT_SLUG="farmacias-braga"

# ── Ingest key — emitida pela Platform Admin Tool ──────────────
# 64 chars hex; ver `npm run tenancy:issue-ingest-key` no repo SaaS.
# Mascarada em todos os logs do agent. Nunca commitar.
SPHARMMT_INGEST_KEY="<colar key 64 chars hex>"

# ── Farmácia (1 agent = 1 farmácia, v1) ─────────────────────────
# CUID (recomendado, sem ambiguidade) ou nome legível (resolvido
# via /api/ingest/v1/farmacias na primeira chamada).
SPHARMMT_FARMACIA="Farmácia Central"
# SPHARMMT_FARMACIA="ckxgzps700001abcde123456"   # alternativa cuid

# ── SQL Server local — SPharm ERP (Softreis) ────────────────────
ERP_SQLSERVER_HOST="localhost"
ERP_SQLSERVER_PORT="1433"
ERP_SQLSERVER_DATABASE="SPHARM"
ERP_SQLSERVER_USER="spharm_readonly"
ERP_SQLSERVER_PASSWORD="<password do user read-only>"
ERP_SQLSERVER_ENCRYPT="0"           # 1 se SQL Server tiver TLS, 0 LAN
ERP_SQLSERVER_TRUST_CERT="1"        # 1 aceita self-signed cert

# ── Opcional: override do directório de output ──────────────────
# Default: agent/output/ (relativo ao binário). Útil em deployments
# onde o agent não é dono da sua pasta.
# SPHARMMT_AGENT_OUTPUT_DIR="C:\\spharm-agent\\output"

# ── Versão reportada no heartbeat (futuro) ──────────────────────
# SPHARMMT_AGENT_VERSION="0.1.0"
