# Normalização de fim-de-linha.
#
# CRÍTICO: o repositório é desenvolvido em Windows com core.autocrlf=true.
# Sem estas regras, qualquer ficheiro .sh sai do checkout com CRLF e falha
# na VPS Ubuntu com o erro clássico `\r: command not found` ou
# `bad interpreter: /usr/bin/env bash^M: no such file or directory`.
# Os scripts de deploy TÊM de ser LF, sempre, em qualquer plataforma.

* text=auto

*.sh            text eol=lf
*.bash          text eol=lf
*.env           text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
deploy/**       text eol=lf

# Scripts PowerShell mantêm CRLF (executados em Windows).
*.ps1           text eol=crlf

# Binários — nunca normalizar.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.xlsx          binary
*.xls           binary
