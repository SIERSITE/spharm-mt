<?xml version="1.0" encoding="utf-8"?>
<!--
  Fontes NuGet explícitas.

  Sem isto, o MSBuild resolve o SDK do WiX contra a configuração global
  da máquina — que numa máquina de compilação limpa pode não ter fonte
  nenhuma. O erro que dá nesse caso ("Could not resolve SDK
  WixToolset.Sdk") não menciona NuGet, e manda-se procurar no sítio
  errado. Fixar a fonte aqui torna a compilação reproduzível em qualquer
  máquina, que é o ponto de um instalador.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
