//////////////////////////////////////////////////////
// INGESTÃO
//////////////////////////////////////////////////////

/// Registo de cada lote recebido/processado.
model LoteIngestao {
  id                String             @id @default(cuid())
  farmaciaId        String
  tipo              TipoLoteIngestao
  dataReferencia    DateTime
  dataProcessamento DateTime?
  estado            EstadoLoteIngestao @default(RECEBIDO)
  totalRegistos     Int?
  totalAceites      Int?
  totalRejeitados   Int?
  mensagemErro      String?
  nomeFicheiro      String?
  blobUrl           String?
  hashConteudo      String?
  dataCriacao       DateTime           @default(now())
  dataAtualizacao   DateTime           @updatedAt

  farmacia Farmacia @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  vendas           Venda[]
  vendasMensais    VendaMensal[]
  compras          Compra[]
  devolucoes       Devolucao[]
  historicoStocks  HistoricoStock[]
  produtosInternos ProdutoInterno[]
  ajustesStock     AjusteStock[]
  inventarios      Inventario[]

  @@index([farmaciaId, tipo, dataReferencia])
  @@index([estado])
}

//////////////////////////////////////////////////////
// INGESTÃO RAW — STAGING DO BOOTSTRAP DO AGENT
//
// Tabelas que recebem dados do agent bootstrap-upload em formato
// **raw**, sem agregação. Distintas das tabelas operacionais (Venda,
// VendaMensal) porque preservam todos os campos do ERP por linha,
// incluindo TipoDocumento e raw JSON, para caracterização e replay.
//
// O passo seguinte (futuro) — uma vez consolidada a semântica de
// [Tipo Documento] e [Valor_EUR] — vai aggregar estas linhas em
// VendaMensal via job server-side. Por agora, esta tabela é apenas
// staging.
//////////////////////////////////////////////////////

/// Linhas de venda raw vindas do ERP Softreis via agent bootstrap.
/// Idempotência forte: `@@unique(farmaciaId, externalSaleLineId)`.
/// Reupload do mesmo Detalhe ID actualiza a row em vez de duplicar.
model IngestVendaLinhaRaw {
  id                 String   @id @default(cuid())
  farmaciaId         String

  /// Softreis: Atendimento.[Atendimento ID]. Header da venda.
  externalSaleId     Int
  /// Softreis: Atendimento Detalhe.[Detalhe ID]. PK da linha de
  /// detalhe — base da idempotência.
  externalSaleLineId Int
  /// Sequência da linha dentro do atendimento. Permite ordenar e
  /// distinguir linhas duplicadas legítimas no mesmo Atendimento ID.
  sequencia          Int?

  dataVenda          DateTime?
  /// Softreis: Atendimento.[Tipo Documento]. Raw int.
  tipoDocumento      Int?
  /// Classificação JS-side ao recepcionar a linha. Strings simples
  /// para não criar dependência cross-tenant em Prisma enums.
  /// Valores conhecidos: "VENDA", "DEVOLUCAO_ANULACAO", "UNKNOWN".
  tipoDocumentoClass String

  /// Softreis: CodigoID. Sempre presente.
  externalProductId  Int
  /// Resolvido server-side em best-effort via Produto.externalProductId.
  /// Null quando o produto não está em Stocks (data quality issue —
  /// agent reporta no dry-run e aqui fica registo permanente).
  produtoId          String?
  /// Linha técnica/serviço sem produto operacional (Softreis:
  /// Stocks.[Processa_Stocks] = 0). Inclui taxas (entrega ao
  /// domicílio, serviço), administração de injectáveis,
  /// rastreios Checksaude, etc. Marcado server-side quando o
  /// agent envia `processaStocks=false` E o lookup ao Produto
  /// falha. Excluído da agregação `VendaMensal`.
  isNonStockService  Boolean  @default(false)

  quantidade         Decimal? @db.Decimal(14, 3)
  pvpUnitario        Decimal? @db.Decimal(12, 4)
  valorLinha         Decimal? @db.Decimal(14, 2)
  ivaValor           Decimal? @db.Decimal(14, 2)
  descontoValor      Decimal? @db.Decimal(14, 2)
  comparticipacao1   Decimal? @db.Decimal(14, 2)
  comparticipacao2   Decimal? @db.Decimal(14, 2)
  entidadeId         Int?

  /// Payload bruto recebido (forensic). Permite reprocessamento sem
  /// re-query ao ERP se a interpretação mudar.
  rawJson            Json

  importedAt         DateTime @default(now())

  farmacia Farmacia @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto  Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@unique([farmaciaId, externalSaleLineId])
  @@index([farmaciaId, dataVenda])
  @@index([externalSaleId])
  @@index([tipoDocumento])
  @@index([produtoId])
  @@index([isNonStockService])
}

//////////////////////////////////////////////////////
// STAGING — COMPRAS + DEVOLUÇÕES A FORNECEDOR (Fase 1b.1)
//////////////////////////////////////////////////////
//
// Tabelas de staging WRITE-ONLY nesta fase. Zero consumidores
// downstream: dashboard, vendas, encomendas, export-orders e
// `Compra`/`Devolucao` finais não tocam aqui. Fase 1c+ adicionará o
// aggregator que escreve em `Compra`/`Devolucao`.
//
// Mapping validado (rev24 inspection.md):
//   Compras   = dbo.Recepcao (header) + dbo.[Recepcao Detalhe] (linhas)
//               · PK linha = [Detalhe  Recp ID] (DOIS espaços, quirk Softreis)
//               · Filtro válido: RecepcaoSituacaoID = 'N'
//               · Valor_EUR é UNITÁRIO; total linha = Quantidade × Valor_EUR
//   Devoluções = dbo.Devolucao + dbo.[Devolucao Detalhe]
//               · Sempre AO fornecedor (FK declarada a Fornecedores)
//               · Filtro válido: DevolucaoSituacaoID <> 'A'
//               · Valor em Devolucao Detalhe é TOTAL DA LINHA (Qt × PVF_EUR)
//
// Idempotência: `@@unique([farmaciaId, externalLineId])` em ambas.
// Re-run do mesmo intervalo UPSERTa — devoluções P→R transition é
// capturada via update de `devolucaoSituacaoId` + `quantidadeRecebida`.

/// Linhas de compra (recepção de mercadoria) raw vindas do SPharm ERP
/// local. 1 row por linha de dbo.[Recepcao Detalhe]. Header denormalizado
/// em cada linha para reconciliação `SUM(qt × valorEurUnit) ≈ headerTotalIncidenciaEur`
/// sem JOIN. Esta tabela é APENAS staging — Fase 1b não tem agregação.
model StagingCompraRawLine {
  id                          BigInt   @id @default(autoincrement())
  farmaciaId                  String

  // ── Identidade ERP ────────────────────────────────────────────
  /// dbo.Recepcao.[Recepcao ID]. Header.
  externalReceptionId         Int
  /// dbo.[Recepcao Detalhe].[Detalhe  Recp ID] (dois espaços no nome
  /// do campo no SPharm — quirk Softreis preservado server-side).
  /// PK natural da linha; base da idempotência.
  externalLineId              Int
  sequencia                   Int?

  // ── Header (denormalizado para reconciliação sem JOIN) ────────
  /// dbo.Recepcao.[NRecepcao]. Numerador interno sequencial.
  externalNRecepcao           Int
  /// dbo.Recepcao.[Fornecedor ID]. Resolução para Fornecedor canónico
  /// faz-se a jusante via FornecedorErpRef — não materializada aqui.
  externalFornecedorId        Int
  /// dbo.Recepcao.[FornecedorTipoDocumentoID] (Tipo Documento).
  /// 99% Factura (2); resto: G/Remessa, G/Transporte, NC, NULL.
  externalTipoDocumentoId     Int?
  /// dbo.Recepcao.[Fornecedor_NDoc]. Nº documento externo do fornecedor.
  externalFornecedorNDoc      String?
  /// dbo.Recepcao.[Data Recepcao] — canónica para data de operação.
  dataRecepcao                DateTime
  /// dbo.Recepcao.[Fornecedor_Data] — data da factura externa.
  fornecedorData              DateTime?
  /// dbo.Recepcao.[ArmazemID]. v1 assume single-warehouse por farmácia.
  armazemId                   Int
  /// dbo.Recepcao.[RecepcaoSituacaoID]. Filtrado a 'N' no SQL; capturado
  /// para auditoria + safety net.
  recepcaoSituacaoId          String
  headerTotalBrutoEur         Decimal  @db.Decimal(12, 2)
  headerTotalIvaEur           Decimal  @db.Decimal(12, 2)
  headerTotalIncidenciaEur    Decimal  @db.Decimal(12, 2)

  // ── Linha (raw, NÃO agregada) ────────────────────────────────
  /// dbo.[Recepcao Detalhe].CodigoID → resolvido para Produto via
  /// ProdutoFarmacia.externalProductId a jusante (fora desta fase).
  externalCodigoId            Int
  quantidade                  Int
  bonus                       Int
  iva                         Decimal  @db.Decimal(4, 2)
  desconto                    Decimal? @db.Decimal(7, 2)
  /// dbo.[Recepcao Detalhe].[Preco Venda Publico_EUR].
  precoVendaPublicoEur        Decimal  @db.Decimal(8, 2)
  /// dbo.[Recepcao Detalhe].[Valor_EUR]. **UNITÁRIO** (PVF c/ desconto,
  /// sem IVA). Total linha = quantidade × valorEurUnit. Validado rev24
  /// pelas amostras 4.1. Naming explícito para impedir confusão.
  valorEurUnit                Decimal  @db.Decimal(10, 2)
  validade                    DateTime?

  ingestedAt                  DateTime @default(now())
  /// Batch ULID emitido pelo agent. Permite cleanup direccionado:
  /// `DELETE WHERE ingestBatchId = ?` para reverter passagem específica.
  ingestBatchId               String

  farmacia Farmacia @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([farmaciaId, externalLineId])
  @@index([farmaciaId, dataRecepcao])
  @@index([farmaciaId, externalCodigoId, dataRecepcao])
  @@index([farmaciaId, externalFornecedorId, dataRecepcao])
  @@index([farmaciaId, ingestBatchId])
}

/// Linhas de devolução a fornecedor raw vindas do SPharm ERP local.
/// 1 row por linha de dbo.[Devolucao Detalhe]. dbo.Devolucao é SEMPRE
/// AO fornecedor — FK declarada a dbo.Fornecedores garante. Devoluções
/// de cliente (raras) fluem por Atendimento Detalhe com TipoDocumento=104,
/// não entram aqui.
///
/// Estados capturados: P (Pendente), E (Parcialmente Resolvida),
/// R (Resolvida), X (Pend.Emissão). Anuladas (A) excluídas no SQL.
/// Transição P→R muda `quantidadeRecebida` (0 → >0) sem alterar PK;
/// re-sync via UPSERT captura.
model StagingDevolucaoFornecedorRawLine {
  id                          BigInt   @id @default(autoincrement())
  farmaciaId                  String

  // ── Identidade ERP ────────────────────────────────────────────
  /// dbo.Devolucao.[Devolucao ID]. Header.
  externalDevolucaoId         Int
  /// dbo.[Devolucao Detalhe].[Devolucao Detalhe ID]. PK natural da linha.
  externalLineId              Int
  sequencia                   Int?

  // ── Header (denormalizado) ────────────────────────────────────
  externalNDevolucao          Int
  externalFornecedorId        Int
  dataDevolucao               DateTime
  /// 'P' | 'E' | 'R' | 'X'. NUNCA 'A' (filtrado no SQL).
  devolucaoSituacaoId         String
  armazemId                   Int
  /// dbo.Devolucao.[Observacoes]. Texto livre operador.
  observacoes                 String?

  // ── SAFT compliance (auditoria fiscal PT) ────────────────────
  serieFacturacao             String?
  atcud                       String?
  ncertAt                     Int?
  systemEntryDate             DateTime?

  headerTotalDocumento        Decimal  @db.Decimal(9, 2)
  headerTotalIvaEur           Decimal  @db.Decimal(12, 2)
  headerTotalIncidenciaEur    Decimal  @db.Decimal(12, 2)

  // ── Linha ─────────────────────────────────────────────────────
  externalCodigoId            Int
  /// Qt enviada ao fornecedor (decisão operacional, momento da emissão).
  quantidadeEnviada           Int
  /// Qt aceite pelo fornecedor após resolução. = 0 enquanto estado='P'.
  quantidadeRecebida          Int
  bonus                       Int?
  /// dbo.[Devolucao Detalhe].[Motivo] → dbo.Motivos (FK declarada).
  motivoId                    Int?
  iva                         Decimal  @db.Decimal(4, 2)
  /// dbo.[Devolucao Detalhe].[PVP_EUR].
  precoVendaPublicoEur        Decimal? @db.Decimal(8, 2)
  /// dbo.[Devolucao Detalhe].[PVF_EUR]. UNITÁRIO (PVF c/ desconto).
  pvfEurUnit                  Decimal? @db.Decimal(8, 2)
  /// dbo.[Devolucao Detalhe].[Valor]. **TOTAL DA LINHA**
  /// (Qt Enviada × PVF_EUR). Validado rev24 pelas amostras 4.2.
  /// Atenção: semântica diferente de StagingCompraRawLine.valorEurUnit.
  valorEurTotal               Decimal? @db.Decimal(9, 2)
  validade                    DateTime?
  lote                        String?
  /// dbo.[Devolucao Detalhe].[Recepcao_Origem]. Texto livre não-estruturado
  /// (ex: "Factura 26385870"). Captura mas não permite JOIN à recepção
  /// original. Auditoria de custo-de-origem ficaria deferida para outra fase.
  recepcaoOrigemText          String?
  recepcaoOrigemData          DateTime?

  ingestedAt                  DateTime @default(now())
  ingestBatchId               String

  farmacia Farmacia @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([farmaciaId, externalLineId])
  @@index([farmaciaId, dataDevolucao])
  @@index([farmaciaId, externalCodigoId, dataDevolucao])
  @@index([farmaciaId, externalFornecedorId, dataDevolucao])
  @@index([farmaciaId, devolucaoSituacaoId])
  @@index([farmaciaId, ingestBatchId])
}

/// Registo de cada execução do pipeline autónomo daily-sync → aggregate
/// → reports. Auditoria + base do health check + página /admin/pipeline.
///
/// Modelo single-shot: o agent (ou o endpoint server-side) POSTa **uma**
/// row com `status='RUNNING'` quando arranca, e faz UPDATE para
/// `OK`/`ERROR`/`ABORTED` no fim. Não é uma máquina de estados com
/// transições intermédias — apenas marca início e fim com payload
/// estruturado em `details`.
///
/// Kinds suportados (string livre, sem enum Prisma para flexibilidade):
///   · "daily-pipeline"    — orquestrador completo do agent on-prem
///   · "daily-sync"        — sub-passo (raro: o orquestrador agrega)
///   · "aggregate-month"   — agregação VendaMensal server-side
///
/// `details` é JSON com counts/timings/IDs operacionais. Estrutura
/// canónica documentada em `lib/pipeline/types.ts`.
///
/// Garantias de leitura:
///   · `[farmaciaId, kind, startedAt]` indexado → última execução por
///     tipo num único query
///   · `[status, startedAt]` indexado → listagem de falhas recentes
///   · Sem retenção automática — opera com 1 row por dia × kind, ou
///     seja ~3 rows/dia × tenant. 12 meses = ~1k rows. Append-only.
model PipelineRun {
  id           String   @id @default(cuid())
  farmaciaId   String
  kind         String
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  /// "RUNNING" | "OK" | "ERROR" | "ABORTED"
  status       String   @default("RUNNING")
  /// Período coberto. YYYY-MM-DD para daily-*, YYYY-MM para aggregate.
  dateRef      String?
  durationMs   Int?
  errorMessage String?
  /// JSON estruturado — ver lib/pipeline/types.ts para shape.
  details      Json     @default("{}")
  /// "agent" | "operator" | "admin" | "scheduler"
  triggeredBy  String   @default("agent")
  /// Chave determinística enviada pelo agent (ex:
  /// `daily-pipeline:<farmaciaId>:<dateRef>:<startedAt-iso>`). Quando
  /// presente, /api/admin/pipeline/record faz upsert por esta chave em
  /// vez de criar nova row — defesa contra retries do agent que
  /// duplicariam o audit log. Opcional para back-compat com agents
  /// antigos que não enviam.
  idempotencyKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farmacia Farmacia @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([farmaciaId, kind, startedAt])
  @@index([status, startedAt])
}

/// Lookup de classificação semântica para `Atendimento.[Tipo Documento]`.
/// PK natural = valor raw do ERP (Int). Aplicado no endpoint
/// `/api/ingest/v1/bootstrap/sales-lines` no momento do upsert; também
/// usado pelo script `scripts/reclassify-ingest-vendas.ts` para
/// reclassificar `IngestVendaLinhaRaw` já carregada.
///
/// Classes válidas (string, sem enum Prisma para flexibilidade de
/// reclassificação retroactiva sem migration):
///   · VENDA               — venda comercial; entra em VendaMensal
///   · DEVOLUCAO_ANULACAO  — sinal negativo na agregação
///   · UNKNOWN             — caracterização pendente; staging conserva
///                           a linha mas agregação ignora
///   · IGNORE_TECHNICAL    — linha técnica (consulta, anulação interna);
///                           staging conserva mas agregação ignora
///
/// Editável via SQL directo OU script `scripts/classify-tipodoc.ts`.
/// O endpoint lê esta tabela em cada batch — alteração é imediata
/// para uploads futuros. Para staging existente, correr o reclassify
/// script.
model TipoDocumentoClassificacao {
  /// Valor raw do ERP — Atendimento.[Tipo Documento]
  tipoDocumento Int      @id
  /// Classe canónica SPharm.MT — uma das 4 strings acima
  classe        String
  /// Label legível (ex: "Venda OTC sem receita", "Anulação interna")
  descricao     String?
  /// Notas livres para contexto operacional
  notas         String?
  /// Quem classificou (email do operador, "system" para seeds, ou
  /// "agent-fallback" se mantido por compat)
  classifiedBy  String?
  classifiedAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([classe])
}

//////////////////////////////////////////////////////
// OUTBOX DOWNSTREAM (SPharmMT → SPharm)
//
// Fluxo outbound para exportar listas de encomenda criadas em
// SPharmMT para a base de dados SQL Server da farmácia (SPharm).
// Aplicação do padrão transactional outbox: a linha OrderOutbox é
// criada na MESMA transacção do ListaEncomenda, garantindo que
// nenhuma ordem fica órfã.
//
// O agent Windows (scheduled task --pull-downstream, 5 em 5 min):
//   1. GET /api/outbox/v1/orders/pending → recebe rows já leased
//   2. Escreve cada encomenda no SQL Server SPharm (transacção local)
//   3. POST /orders/{id}/ack com o spharmDocumentId retornado
//   4. Em falha → POST /orders/{id}/nack com retryable=true|false
//
// Idempotência: cada outbox row tem um idempotencyKey determinístico
// derivado de tenantSlug + listaEncomendaId. A estratégia exacta de
// reconhecimento desse key em SPharm fica provisional até recebermos
// o schema real do SPharm — ver doc §4.2 do plano bidireccional.
//////////////////////////////////////////////////////

/// Outbox de exportação de encomendas. 1:1 com ListaEncomenda.
/// Criado na mesma transacção via lib/ingest/orders.ts:createEncomendaWithOutbox.
model OrderOutbox {
  id               String @id @default(cuid())
  listaEncomendaId String @unique
  /// Denormalizado para permitir index (farmaciaId, state) sem join
  /// na query hot-path do agent.
  farmaciaId       String

  /// Snapshot congelado do payload que o agent vai escrever em SPharm.
  /// JSON serializado. IMUTÁVEL — edições à lista após criação do
  /// outbox requerem cancelar+recriar (ver lib/ingest/orders.ts).
  payloadJson String

  /// Chave determinística: "{tenantSlug}:{listaEncomendaId}". Usada
  /// pelo agent como stamp para idempotência em SPharm. A ferramenta
  /// de stamping em SPharm será decidida quando chegar o schema real.
  idempotencyKey String @unique

  /// Hash sha256 do payloadJson. Se o mesmo idempotencyKey alguma vez
  /// aparecer com hash diferente, o agent deve abortar e marcar
  /// FALHADO — defesa contra mutação acidental do payload congelado.
  payloadHash String

  state OrderExportState @default(PENDENTE)

  /// Contador de tentativas (incluindo a corrente). Reset a 0 no /retry.
  attemptCount  Int       @default(0)
  /// Próxima janela elegível para o agent claim. now() inicial.
  /// Schedule de retry: 1m · 5m · 30m · 2h · 8h · 24h · então FALHADO.
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  lastAttemptAt DateTime?

  // ── Lease ────────────────────────────────────────────────────────
  /// Identificador da instância do agent que reclamou a row.
  /// Null quando não há lease activa.
  leasedBy    String?
  /// TTL da lease. 5 min por defeito — próximo run reclama após isto.
  leasedUntil DateTime?

  // ── Confirmação ──────────────────────────────────────────────────
  /// Número de documento atribuído por SPharm depois do INSERT.
  /// Preenchido no endpoint /ack.
  spharmDocumentId String?
  exportedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listaEncomenda ListaEncomenda     @relation(fields: [listaEncomendaId], references: [id], onDelete: Cascade)
  audits         OrderExportAudit[]

  // Hot path: o agent pede pending rows ordenadas por nextAttemptAt.
  @@index([state, nextAttemptAt])
  // Hot path: admin UI lista por farmácia + estado.
  @@index([farmaciaId, state])
  // Liveness check admin: "qual foi a última tentativa?"
  @@index([lastAttemptAt])
}

/// Histórico imutável de tentativas de exportação. NUNCA apagar linhas.
/// Cada /ack, /nack, /retry e /cancel grava uma row aqui para
/// rastreabilidade operacional. O OrderOutbox guarda apenas o estado
/// corrente; a timeline completa vive aqui.
model OrderExportAudit {
  id             String   @id @default(cuid())
  outboxId       String
  attempt        Int
  at             DateTime @default(now())
  /// "ATTEMPT" | "SUCCESS" | "FAILURE" | "RETRY_SCHEDULED" |
  /// "GAVE_UP" | "MANUAL_RETRY" | "MANUAL_CANCEL" | "LEASE_CLAIMED" |
  /// "LEASE_RELEASED" | "LEASE_EXPIRED"
  status         String
  message        String?
  httpStatus     Int?
  spharmSqlError String?
  /// ID do utilizador que executou a acção manual, se aplicável.
  /// Null para acções do agent.
  actorId        String?

  outbox OrderOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId, at])
  @@index([status, at])
}
