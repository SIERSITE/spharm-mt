// DADOS TRANSACIONAIS
//////////////////////////////////////////////////////

/// Vendas diárias agregadas por produto-dia-farmácia.
model Venda {
  id                   String     @id @default(cuid())
  farmaciaId           String
  produtoId            String
  data                 DateTime
  quantidade           Decimal    @db.Decimal(14, 3)
  valorTotal           Decimal    @db.Decimal(14, 2)
  valorUnitario        Decimal?   @db.Decimal(12, 4)
  custoUnitario        Decimal?   @db.Decimal(12, 4)
  tipoVenda            TipoVenda?
  valorComparticipacao Decimal?   @db.Decimal(14, 2)
  valorPagoUtente      Decimal?   @db.Decimal(14, 2)
  numeroTransacoes     Int?
  dataIngestao         DateTime   @default(now())
  loteIngestaoId       String?

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  @@index([farmaciaId, data])
  @@index([produtoId, data])
  @@index([farmaciaId, produtoId, data])
  @@index([loteIngestaoId])
}

/// Vendas mensais agregadas. Granularidade canónica:
/// `(farmaciaId, produtoId, ano, mes)`.
///
/// Fontes possíveis (campo `origemAgregacao`):
///   · "agent-bootstrap-staging"  — agregação server-side de
///     IngestVendaLinhaRaw via `scripts/aggregate-vendamensal.ts`
///   · null / legado              — import Excel ou outras fontes
///     pré-aggregation script (legacy)
///
/// Campos legados (`quantidade`, `valorTotal`, `mesCompleto`,
/// `origemBootstrap`, `dataAtualizacao`, `loteIngestaoId`)
/// preservados para compatibilidade com loaders e dashboards
/// existentes — `aggregate-vendamensal.ts` populá-os a partir dos
/// novos campos para que o dashboard continue intacto.
model VendaMensal {
  id         String @id @default(cuid())
  farmaciaId String
  produtoId  String
  ano        Int
  mes        Int

  // ── Campos legados (NOT NULL, populados por loaders Excel + agg script)
  quantidade      Decimal  @db.Decimal(14, 3)
  valorTotal      Decimal  @db.Decimal(14, 2)
  mesCompleto     Boolean  @default(true)
  origemBootstrap Boolean  @default(false)
  dataAtualizacao DateTime @updatedAt
  loteIngestaoId  String?

  // ── Campos da agregação (nullable até script popular) ──────────────
  /// SUM assinado de quantidade (VENDA=+, DEVOLUCAO_ANULACAO=−).
  quantidadeLiquida   Decimal? @db.Decimal(14, 3)
  /// SUM assinado de pvpUnitario × quantidade. "Bruto" = teto comercial.
  valorBruto          Decimal? @db.Decimal(14, 2)
  /// SUM assinado de valorLinha (semântica observada: pago utente).
  valorPagoUtente     Decimal? @db.Decimal(14, 2)
  /// SUM assinado de comparticipacao1 + comparticipacao2.
  valorComparticipado Decimal? @db.Decimal(14, 2)
  /// COUNT(*) de linhas que compuseram a agregação.
  linhasVenda         Int?
  /// COUNT(DISTINCT externalSaleId) — número de atendimentos distintos.
  atendimentos        Int?
  /// Marcador da origem da agregação. Permite distinguir rows
  /// agregadas server-side de rows legadas Excel-import.
  origemAgregacao     String?
  /// Timestamp da primeira escrita do row (separa criação de actualização).
  createdAt           DateTime @default(now())

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  @@unique([farmaciaId, produtoId, ano, mes])
  @@index([ano, mes])
  @@index([farmaciaId, ano, mes])
  @@index([produtoId, ano, mes])
  @@index([origemAgregacao])
}

/// Compras diárias agregadas por produto-dia-farmácia-fornecedor.
///
/// Granularidade: 1 row por (farmaciaId, produtoId, fornecedorId, data).
/// A aggregation Phase 1c soma todas as linhas de `StagingCompraRawLine`
/// resolvidas (produto + fornecedor) que caem no mesmo dia e produz/UPSERTa
/// esta row. O unique `Compra_aggregation_key` garante idempotência da
/// re-aggregation — re-correr a mesma janela actualiza valores em vez de
/// duplicar.
///
/// Campos `ingestBatchId` e `aggregatedAt` ficam `null` em rows legacy
/// (excel import, etc.) — não tocadas pelo aggregation pipeline nesta fase.
model Compra {
  id                  String    @id @default(cuid())
  farmaciaId          String
  produtoId           String
  fornecedorId        String?
  data                DateTime
  quantidade          Decimal   @db.Decimal(14, 3)
  valorTotal          Decimal   @db.Decimal(14, 2)
  precoUnitario       Decimal?  @db.Decimal(12, 4)
  descontoBonificacao Decimal?  @db.Decimal(14, 2)
  numeroDocumento     String?
  dataIngestao        DateTime  @default(now())
  loteIngestaoId      String?
  /// Batch ULID emitido pela aggregation. Permite cleanup direccionado
  /// (`DELETE WHERE ingestBatchId = ?`) e auditoria "que run produziu esta row?".
  ingestBatchId       String?
  /// Quando a row foi (re)produzida pela aggregation. NULL → row legacy
  /// não tocada pelo pipeline 1c.
  aggregatedAt        DateTime?
  /// true quando TODAS as linhas que formaram esta row vieram de
  /// documentos RECONCILIADOS. Só então `precoUnitario` representa um
  /// custo real e pode alimentar `ultimoPrecoCompra`.
  ///
  /// Um booleano e não o valor do documento: `Compra` é agregada por
  /// produto-dia e pode juntar documentos, portanto guardar aqui um
  /// total documental convidaria ao rateio que está proibido. O valor
  /// financeiro do documento vive em `CompraDocumento` e fica lá.
  ///
  /// NULL = agregação anterior a esta classificação, estado desconhecido.
  /// Quem calcula custo trata NULL como não fiável.
  custoFiavel         Boolean?

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedor   Fornecedor?   @relation("CompraFornecedor", fields: [fornecedorId], references: [id])
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  /// Idempotência da aggregation (granularidade produto-dia-fornecedor-farmácia).
  /// fornecedorId é nullable → Postgres aceita múltiplos NULLs no unique.
  /// Mitigação: aggregation nunca produz rows com fornecedorId NULL (são
  /// orphans e ficam fora do write).
  @@unique([farmaciaId, produtoId, fornecedorId, data], name: "Compra_aggregation_key")
  @@index([farmaciaId, data])
  @@index([produtoId, data])
  @@index([fornecedorId])
  @@index([farmaciaId, produtoId, data])
  @@index([loteIngestaoId])
  @@index([ingestBatchId])
  @@index([aggregatedAt])
}

/// Devoluções diárias.
///
/// Granularidade: 1 row por linha do staging (`StagingDevolucaoFornecedorRawLine`).
/// `externalLineId` é a chave natural (dbo.[Devolucao Detalhe].[Devolucao
/// Detalhe ID]); idempotência da aggregation via UPSERT em
/// `(farmaciaId, externalLineId)`. Estado P→R muda `quantidadeRecebida`
/// no staging e a aggregation re-produz a row sem duplicar.
///
/// `externalLineId`/`ingestBatchId`/`aggregatedAt` ficam `null` em rows
/// legacy (excel import, etc.).
model Devolucao {
  id                  String        @id @default(cuid())
  farmaciaId          String
  produtoId           String
  /// dbo.[Devolucao Detalhe].[Devolucao Detalhe ID]. NULL em rows legacy.
  externalLineId      Int?
  data                DateTime
  quantidade          Decimal       @db.Decimal(14, 3)
  valor               Decimal       @db.Decimal(14, 2)
  tipo                TipoDevolucao
  motivo              String?
  fornecedorDestinoId String?
  dataIngestao        DateTime      @default(now())
  loteIngestaoId      String?
  ingestBatchId       String?
  aggregatedAt        DateTime?

  farmacia          Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto           Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorDestino Fornecedor?   @relation("DevolucaoFornecedorDestino", fields: [fornecedorDestinoId], references: [id])
  loteIngestao      LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  /// Idempotência da aggregation Phase 1c (granularidade linha).
  /// Múltiplos NULLs permitidos (rows legacy não conflitam).
  @@unique([farmaciaId, externalLineId])
  @@index([farmaciaId, data])
  @@index([produtoId, data])
  @@index([tipo])
  @@index([fornecedorDestinoId])
  @@index([loteIngestaoId])
  @@index([ingestBatchId])
  @@index([aggregatedAt])
}

/// Histórico periódico de stock por produto-farmácia.
model HistoricoStock {
  id             String   @id @default(cuid())
  farmaciaId     String
  produtoId      String
  dataFotografia DateTime
  quantidade     Decimal  @db.Decimal(14, 3)
  valorCusto     Decimal? @db.Decimal(14, 2)
