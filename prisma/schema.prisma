  OUTRO
}

enum TipoDevolucao {
  CLIENTE
  FORNECEDOR
  OUTRA
}

enum PrioridadeRevisao {
  ALTA
  MEDIA
  BAIXA
}

enum EstadoFilaRevisao {
  PENDENTE
  RESOLVIDO
  IGNORADO
}

enum TipoRevisao {
  NOVO_PRODUTO
