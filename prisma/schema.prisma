enum EstadoListaEncomenda {
  RASCUNHO
  FINALIZADA
  EXPORTADA
}

/// Estado do fluxo outbound de exportação de uma lista de encomenda
/// para a instância SPharm da farmácia. Distinto de EstadoListaEncomenda:
/// aquele é a fase de negócio (rascunho → finalizada → exportada); este
/// é o sub-estado da máquina de outbox dentro da fase "finalizada".
///
/// Transições válidas:
///   PENDENTE      → EM_EXPORTACAO  (agent claimed lease)
///   EM_EXPORTACAO → EXPORTADO      (agent confirmed write via ack)
///   EM_EXPORTACAO → PENDENTE       (nack retryable, schedule next attempt)
///   EM_EXPORTACAO → FALHADO        (nack non-retryable OR max attempts)
///   FALHADO       → PENDENTE       (manual re-send via /retry endpoint)
///   PENDENTE      → CANCELADO      (admin cancel antes da exportação)
///   FALHADO       → CANCELADO      (admin desiste de re-tentar)
enum OrderExportState {
  PENDENTE
  EM_EXPORTACAO
  EXPORTADO
  FALHADO
  CANCELADO
}

enum TipoLoteIngestao {
  FICHA
  STOCK
  VENDAS
  VENDAS_MENSAIS
  COMPRAS
  DEVOLUCOES
  AJUSTES_STOCK
  INVENTARIO
  PRODUTOS_INTERNOS
}

enum EstadoLoteIngestao {
  RECEBIDO
  EM_PROCESSAMENTO
  PROCESSADO
  FALHOU
}

enum ClassificacaoRotacao {
  NORMAL
  ATENCAO
  SEM_ROTACAO
}

enum ClassificacaoABC {
  A
  B
  C
  NAO_CLASSIFICADO
}

enum EnriquecimentoEstado {
  PENDENTE
  EM_PROCESSAMENTO
  SUCESSO
  SUCESSO_PARCIAL
  FALHOU
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  PARTIALLY_VERIFIED
  FAILED
  NEEDS_REVIEW
}

enum TipoAjusteStock {
  POSITIVO
  NEGATIVO
  CORRECAO
  QUEBRA
  PERDA
  OUTRO
}

enum EstadoInventario {
  RASCUNHO
  FECHADO
  PROCESSADO
  CANCELADO
}

/// Estados do ciclo de vida de um RegulatoryAcquisitionJob.
/// Transições típicas:
///   PENDING      → IN_PROGRESS    (worker claimed)
///   IN_PROGRESS  → DONE           (todos os campos obtidos)
///   IN_PROGRESS  → PARTIAL        (alguns campos obtidos, retry agendado)
///   IN_PROGRESS  → PENDING        (transient failure, backoff agendado)
///   IN_PROGRESS  → FAILED         (max attempts excedidas)
///   IN_PROGRESS  → BLOCKED        (ambiguidade, requer revisão manual)
///   PARTIAL      → IN_PROGRESS    (worker tenta de novo para completar)
enum AcquisitionJobStatus {
  PENDING
  IN_PROGRESS
  DONE
  PARTIAL
  FAILED
  BLOCKED
}

//////////////////////////////////////////////////////
// CATÁLOGO CENTRAL
//////////////////////////////////////////////////////

/// Produto global do grupo, identificado por CNP.
model Produto {
  id                        String             @id @default(cuid())
  cnp                       Int                @unique
  /// Identificador do produto no ERP da farmácia (Softreis: Stocks.CodigoID).
  /// Mantido como referência cross-tenant para o agent bootstrap-upload
  /// fazer upsert por externalProductId quando o cnp não está disponível.
  /// Único na BD do tenant para idempotência forte.
  externalProductId         Int?               @unique
  designacao                String
  fabricanteId              String?
  classificacaoNivel1Id     String?
  classificacaoNivel2Id     String?
  tipoArtigo                String?
  codigoATC                 String?
  dci                       String?
  imagemUrl                 String?
  formaFarmaceutica         String?
  dosagem                   String?
  embalagem                 String?
  flagGenerico              Boolean            @default(false)
  flagMSRM                  Boolean            @default(false)
  flagMNSRM                 Boolean            @default(false)
  /// MNSRM **não comparticipado** (Softreis: Stocks.MNSRM_NCompart). Distinto
  /// de `flagMNSRM` (OTC); este sinaliza OTC que não tem comparticipação SNS.
  flagMnsrmNCompart         Boolean            @default(false)
  grupoHomogeneo            String?
  estado                    ProdutoEstado      @default(PENDENTE)
  origemDados               ProdutoOrigemDados @default(FARMACIA)
  validadoManualmente       Boolean            @default(false)
  // Classificação e verificação automática
  productType               String?
  productTypeConfidence     Float?
  classificationSource      String?
  classificationVersion     String?
  verificationStatus        VerificationStatus @default(PENDING)
  lastVerifiedAt            DateTime?
  lastVerificationAttemptAt DateTime?
  externallyVerified        Boolean            @default(false)
  needsManualReview         Boolean            @default(false)
  manualReviewReason        String?
  dataCriacao               DateTime           @default(now())
  dataAtualizacao           DateTime           @updatedAt

  fabricante          Fabricante?    @relation(fields: [fabricanteId], references: [id])
  classificacaoNivel1 Classificacao? @relation("ProdutoClassificacaoNivel1", fields: [classificacaoNivel1Id], references: [id])
  classificacaoNivel2 Classificacao? @relation("ProdutoClassificacaoNivel2", fields: [classificacaoNivel2Id], references: [id])

  produtosFarmacia     ProdutoFarmacia[]
  vendas               Venda[]
  vendasMensais        VendaMensal[]
  compras              Compra[]
  devolucoes           Devolucao[]
  historicoStocks      HistoricoStock[]
  ajustesStock         AjusteStock[]
  linhasInventario     LinhaInventario[]
  indicadores          IndicadoresProdutoFarmacia[]
  linhasEncomenda      LinhaEncomenda[]
  filaRevisao          FilaRevisao[]
  filaEnriquecimento   EnriquecimentoFila[]
  verificacaoHistorico ProdutoVerificacaoHistorico[]
  enrichmentSourceLogs EnrichmentSourceLog[]
  ingestVendasLinhasRaw IngestVendaLinhaRaw[]

  @@index([fabricanteId])
  @@index([classificacaoNivel1Id])
  @@index([classificacaoNivel2Id])
  @@index([estado])
  @@index([verificationStatus])
  @@index([productType])
  @@index([lastVerifiedAt])
}

/// Fabricante normalizado.
model Fabricante {
  id              String         @id @default(cuid())
  nomeNormalizado String         @unique
  paisOrigem      String?
  estado          EntidadeEstado @default(ATIVO)
  dataCriacao     DateTime       @default(now())
  dataAtualizacao DateTime       @updatedAt

  aliases  FabricanteAlias[]
  produtos Produto[]
}

/// Variantes de nomes de fabricante encontradas nas origens.
model FabricanteAlias {
  id           String @id @default(cuid())
  fabricanteId String
  aliasNome    String

  fabricante Fabricante @relation(fields: [fabricanteId], references: [id], onDelete: Cascade)

  @@unique([fabricanteId, aliasNome])
  @@index([aliasNome])
}

/// Árvore de classificação central.
model Classificacao {
  id                 String            @id @default(cuid())
  nome               String
  tipo               TipoClassificacao
  classificacaoPaiId String?
  estado             EntidadeEstado    @default(ATIVO)
  ordem              Int?
  dataCriacao        DateTime          @default(now())
  dataAtualizacao    DateTime          @updatedAt

  classificacaoPai  Classificacao?  @relation("ClassificacaoPaiFilho", fields: [classificacaoPaiId], references: [id])
  subClassificacoes Classificacao[] @relation("ClassificacaoPaiFilho")

  produtosNivel1 Produto[] @relation("ProdutoClassificacaoNivel1")
  produtosNivel2 Produto[] @relation("ProdutoClassificacaoNivel2")

  @@unique([nome, tipo, classificacaoPaiId])
  @@index([tipo])
  @@index([classificacaoPaiId])
}

/// Snapshot local do catálogo INFARMED de medicamentos (Portugal).
///
/// Origem: ficheiro descarregado do portal INFARMED (INFOMED / Open Data).
/// Importado por scripts/import-infarmed-snapshot.ts, idempotente por CNP.
///
/// Consultado pelo infarmedConnector em lib/catalog-connectors.ts,
/// que devolve tier=REGULATORY e confidence=0.95 quando há match por CNP.
/// É a primeira fonte autoritária para escrever Produto.fabricanteId / dci / codigoATC.
model InfarmedSnapshot {
  id                String   @id @default(cuid())
  cnp               Int      @unique
  designacaoOficial String
  dci               String?
  codigoATC         String?
  /// Titular da Autorização de Introdução no Mercado — fabricante canónico.
  titularAim        String?
  formaFarmaceutica String?
  dosagem           String?
  embalagem         String?
  grupoTerapeutico  String?
  /// Estado regulamentar: "Autorizado", "Suspenso", "Revogado", "Caducado".
  /// Produtos não-"Autorizado" não são devolvidos pelo conector.
  estadoAim         String?
  /// Identificador do ficheiro/data do snapshot (ex: "2026-04"). Permite
  /// detectar quando uma reimportação trouxe dados mais recentes.
  snapshotVersion   String
  importedAt        DateTime @default(now())

  @@index([snapshotVersion])
  @@index([estadoAim])
}

/// Camada regulatória v2 (Maio 2026). Tabela standalone, indexada por CNP,
/// alimentada pelo importador genérico `scripts/import-regulatory-record.ts`
/// a partir de qualquer fonte (CEDIME/ANF, INFARMED Open Data, listas
/// comparticipados, genéricos, etc.).
///
/// MVP simples — sem provenance per-field, sem versioning multi-source,
/// sem conflict engine. Merge por CNP com regra "preservar não-null":
/// um import só sobrescreve campos já preenchidos quando corrido com `--force`.
///
/// O `infarmedConnector` em `lib/catalog-connectors.ts` lê esta tabela
/// primeiro e cai em `InfarmedSnapshot` quando o CNP não está aqui.
model RegulatoryRecord {
  cnp               Int      @id
  designacaoOficial String?
  dci               String?
  codigoATC         String?
  formaFarmaceutica String?
  dosagem           String?
  embalagem         String?
  grupoTerapeutico  String?
  /// Titular da AIM (fabricante regulatório).
  titularAim        String?
  /// "Autorizado", "Suspenso", "Revogado", "Caducado", etc.
  estadoAim         String?
  /// Tag livre identificando a fonte/import (ex.: "cedime_anf_2026-05",
  /// "infarmed_comparticipados_2026-04"). O último import vence em campos
  /// que sobrescreva.
  source            String
  importedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([codigoATC])
  @@index([dci])
  @@index([source])
  @@index([estadoAim])
}

/// Job da regulatory acquisition pipeline (Phase 0 — Maio 2026).
///
/// Cada produto que precisa de fetch regulatório (DCI, ATC, forma, dosagem,
/// embalagem, titularAim) entra como um job nesta queue. Workers stateless
/// processam jobs em background, tentam fontes externas em ordem de
/// prioridade, e populam `RegulatoryRecord` quando obtêm dados.
///
/// Lifecycle (ver enum AcquisitionJobStatus):
///   PENDING → IN_PROGRESS → { DONE, PARTIAL, FAILED, BLOCKED }
///
/// Worker — `scripts/workers/regulatory-acquisition-worker.ts`:
///   · Claim com FOR UPDATE SKIP LOCKED (safe para múltiplos workers)
///   · Backoff exponencial (1h, 4h, 1d, 3d, 7d) até MAX_ATTEMPTS=6
///   · GC: jobs IN_PROGRESS há > 30min são reset a PENDING (worker crashed)
///
/// Enqueue — `scripts/enqueue-regulatory-acquisition.ts`:
///   · Por CNP / lista de CNPs / cohort predefinido / ficheiro
///   · Upsert com priority configurável
///
/// Phase 0 (esta versão): zero fetchers reais. Worker simula outcome
/// determinístico para validar o lifecycle. Phase 1+ adiciona fetchers
/// (INFARMED Infomed, WHO ATC, manufacturer pages, etc.).
model RegulatoryAcquisitionJob {
  id              String               @id @default(cuid())
  cnp             Int                  @unique
  designacao      String?
  status          AcquisitionJobStatus @default(PENDING)
  /// Prioridade — menor = primeiro. 1=urgente, 50=normal (default), 100=fundo.
  priority        Int                  @default(50)
  attempts        Int                  @default(0)
  /// Última fonte tentada (para diagnóstico): "infarmed_infomed", "manufacturer_page", …
  lastSourceTried String?
  lastError       String?
  lastAttemptAt   DateTime?
  /// Backoff scheduling — jobs só são claimable quando NOW() >= nextAttemptAt.
  nextAttemptAt   DateTime             @default(now())
  /// Lista de campos já populados em RegulatoryRecord para este CNP
  /// (snapshot na altura do último processamento). Usada para evitar
  /// retentar campos já obtidos.
  fieldsObtained  String[]             @default([])
  /// Resumo bruto de cada fonte tentada (debug). Exemplo:
  /// { "infarmed_infomed": { ok: true, fields: ["dci","atc"] },
  ///   "manufacturer_page": { ok: false, reason: "no match" } }
  sourceResults   Json?
  /// Quando atinge status DONE pela primeira vez. Não é actualizado em
  /// re-runs subsequentes.
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, nextAttemptAt])
  @@index([priority, nextAttemptAt])
}

/// Histórico de verificações automáticas por produto.
model ProdutoVerificacaoHistorico {
  id                 String   @id @default(cuid())
  produtoId          String
  verificadoEm       DateTime @default(now())
  productType        String?
  productTypeConf    Float?
  verificationStatus String
  sourceSummary      Json?
  fieldsUpdated      String[]

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, verificadoEm])
}

/// Resultado de cada chamada a um conector externo.
///
/// Granularidade: uma row por (produto × conector × tentativa) — alimenta
/// as métricas de qualidade de fonte em /admin/catalogo E a evidência
/// detalhada em /admin/catalogo/revisao/[id].
///
/// Status:
///   SUCCESS     — match forte; dados extraídos com confiança suficiente.
///   PARTIAL_HIT — página/registo encontrado mas com dados incompletos
///                 ou similaridade média. Útil mostrar ao admin.
///   NO_MATCH    — sem candidato. Conector tentou mas não achou nada.
///   ERROR       — exceção (timeout, HTTP, parse). errorMessage truncada
///                 a 500 chars.
///
/// Append-only. Não há UPDATE; reverify gera nova row.
model EnrichmentSourceLog {
  id             String                 @id @default(cuid())
  produtoId      String
  source         String
  status         EnrichmentSourceStatus
  /// Confiança devolvida pela fonte para este produto. Preenchido em SUCCESS e PARTIAL_HIT.
  confidence     Float?
  /// "cnp" | "sku" | "designacao" | "fuzzy_name" | "ean" | "unknown".
  matchedBy      String?
  durationMs     Int?
  /// Lista de campos não-null devolvidos pela fonte (fabricante, atc, categoria, …).
  /// Permite contar coverage por campo por fonte.
  fieldsReturned String[]
  errorMessage   String?
  /// URL da página/registo de onde os dados vieram, quando aplicável.
  /// Crucial para conectores web (retail_pharmacy) — admin pode abrir a página.
  url            String?
  /// Query exacta enviada à fonte (DDG, OFF/OBF, etc.). Permite reproduzir a busca.
  query          String?
  /// Marca / fabricante exactamente como aparece na fonte, antes de qualquer
  /// normalização. Mostrado ao admin como sinal cru.
  rawBrand       String?
  /// Categoria/breadcrumb cru, antes do mapeamento canónico.
  rawCategory    String?
  /// Nome do produto na fonte (og:title, h1, designacaoOficial, etc.).
  /// Permite ao admin ver se o conector apanhou o produto certo.
  rawProductName String?
  createdAt      DateTime               @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([source, createdAt])
  @@index([produtoId, createdAt])
  @@index([status, createdAt])
}

enum EnrichmentSourceStatus {
  SUCCESS
  NO_MATCH
  ERROR
  PARTIAL_HIT
}

/// Fornecedor normalizado.
///
/// `nomeNormalizado` é canónico GLOBAL no tenant (uma row por fornecedor real).
/// Várias farmácias do mesmo tenant partilham a mesma row de Fornecedor via
/// `FornecedorErpRef` — cada farmácia tem o seu próprio `Fornecedor ID` interno
/// no SPharm local, mas mapeiam para o mesmo Fornecedor canónico SaaS.
///
/// Campos `nome` e `nif` são metadados derivados do ERP (Fornecedores.[Nome
/// Fornecedor] e [Numero Contribuinte]), populados pelo bootstrap de
/// fornecedores. Nullable porque pré-existem rows de Fornecedor criadas por
/// outros fluxos (encomendas, vendas históricas) sem este detalhe.
model Fornecedor {
  id              String         @id @default(cuid())
  nomeNormalizado String         @unique
  /// Nome completo do fornecedor (ex: "MEPHA - INV. DESEN. FAB. F LDA"),
  /// derivado de dbo.Fornecedores.[Nome Fornecedor]. Pode ser igual a
  /// `nomeNormalizado` quando o ERP só tem nome abreviado.
  nome            String?
  /// NIF / Número Contribuinte. Pode ficar NULL — no SPharm Cotovia ~50%
  /// dos fornecedores não têm NIF preenchido. Não usar como chave natural.
  nif             String?
  tipo            FornecedorTipo @default(OUTRO)
  estado          EntidadeEstado @default(ATIVO)
  dataCriacao     DateTime       @default(now())
  dataAtualizacao DateTime       @updatedAt

  aliases                     FornecedorAlias[]
  erpRefs                     FornecedorErpRef[]
  produtosFarmacia            ProdutoFarmacia[]
  compras                     Compra[]                     @relation("CompraFornecedor")
  devolucoesDestino           Devolucao[]                  @relation("DevolucaoFornecedorDestino")
  indicadoresUltimoFornecedor IndicadoresProdutoFarmacia[] @relation("IndicadorUltimoFornecedor")
  linhasEncomenda             LinhaEncomenda[]             @relation("LinhaEncomendaFornecedorSugerido")
}

/// Variantes de nomes de fornecedor.
model FornecedorAlias {
  id           String @id @default(cuid())
  fornecedorId String
  aliasNome    String

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, aliasNome])
  @@index([aliasNome])
}

/// Link per-farmácia ↔ Fornecedor canónico, com snapshot dos metadados do
/// ERP local no momento da última sync. Permite idempotência
/// `(farmaciaId, externalFornecedorId)` mantendo o `Fornecedor` canónico
/// partilhável entre farmácias do mesmo tenant.
///
/// Source: dbo.Fornecedores (Softreis) + LEFT JOIN a Tbl_Tipo_Fornecedores
/// para denormalizar a descrição do tipo.
model FornecedorErpRef {
  id                    String   @id @default(cuid())
  fornecedorId          String
  farmaciaId            String
  /// Valor de dbo.Fornecedores.[Fornecedor ID] no SPharm local desta farmácia.
  externalFornecedorId  Int
  /// Snapshot dos campos do ERP (auditoria + re-derivação).
  nomeAbreviadoErp      String
  nomeFornecedorErp     String?
  nifErp                String?
  tipoFornecedorErpId   Int?
  tipoFornecedorErpDesc String?
  inactivoErp           Boolean  @default(false)
  /// Última vez que esta ref foi tocada pelo agent (UPSERT).
  lastSyncedAt          DateTime @default(now()) @updatedAt
  /// Batch ULID emitido pelo agent na sync. Útil para reconciliação de
  /// "que linhas vieram nesta passagem?".
  ingestBatchId         String?

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  farmacia   Farmacia   @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([farmaciaId, externalFornecedorId])
  @@index([fornecedorId])
  @@index([farmaciaId, inactivoErp])
  @@index([farmaciaId, lastSyncedAt])
}

//////////////////////////////////////////////////////
// ESTRUTURA MULTI-FARMÁCIA
//////////////////////////////////////////////////////

model Farmacia {
  id              String         @id @default(cuid())
  nome            String
  codigoANF       String?
  morada          String?
  contacto        String?
  estado          EntidadeEstado @default(ATIVO)
  dataAdesao      DateTime       @default(now())
  dataCriacao     DateTime       @default(now())
  dataAtualizacao DateTime       @updatedAt

  utilizadores      Utilizador[]
  utilizadoresExtra UtilizadorFarmacia[]
  produtosFarmacia  ProdutoFarmacia[]
  produtosInternos  ProdutoInterno[]
  vendas            Venda[]
  vendasMensais     VendaMensal[]
  compras           Compra[]
  devolucoes        Devolucao[]
  historicoStocks   HistoricoStock[]
  ajustesStock      AjusteStock[]
  inventarios       Inventario[]
  indicadores       IndicadoresProdutoFarmacia[]
  listasEncomenda   ListaEncomenda[]
  lotesIngestao     LoteIngestao[]
  emailConfig       EmailConfig?
  ingestVendasLinhasRaw IngestVendaLinhaRaw[]
  pipelineRuns          PipelineRun[]
  fornecedorErpRefs     FornecedorErpRef[]
  stagingComprasRawLines              StagingCompraRawLine[]
  stagingDevolucoesFornecedorRawLines StagingDevolucaoFornecedorRawLine[]

  @@unique([nome])
  @@index([codigoANF])
}

// Configuração SMTP por farmácia. Quando farmaciaId é null, é a
// configuração global usada como fallback. A password é guardada
// cifrada (AES-256-GCM) — ver lib/email-crypto.ts.
model EmailConfig {
  id                String    @id @default(cuid())
  farmaciaId        String?   @unique
  farmacia          Farmacia? @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  smtpHost          String
  smtpPort          Int
  smtpUser          String?
  smtpPassEncrypted String?
  smtpSecure        Boolean   @default(false)
  fromEmail         String
  fromName          String?
  replyTo           String?
  isActive          Boolean   @default(true)
  lastTestAt        DateTime?
  lastTestStatus    String?
  lastTestError     String?
  dataCriacao       DateTime  @default(now())
  dataAtualizacao   DateTime  @updatedAt
}

model Utilizador {
  id                 String           @id @default(cuid())
  email              String           @unique
  nome               String
  perfil             UtilizadorPerfil
  /// Farmácia PRIMÁRIA (contexto por defeito para sessão e filtros).
  /// Para GESTOR_GRUPO/ADMINISTRADOR é opcional. Para acesso a várias
  /// farmácias usar a relação `farmacias` (UtilizadorFarmacia).
  farmaciaId         String?
  estado             EntidadeEstado   @default(ATIVO)
  passwordHash       String?
  /// Marca o próximo login como forçado a alterar a password (ex:
  /// reset administrativo). A API /login vai validar e redirigir.
  mustChangePassword Boolean          @default(false)
  ultimoLogin        DateTime?
  dataCriacao        DateTime         @default(now())
  dataAtualizacao    DateTime         @updatedAt

  farmacia        Farmacia?            @relation(fields: [farmaciaId], references: [id])
  farmacias       UtilizadorFarmacia[]
  listasEncomenda ListaEncomenda[]
  auditoria       AuditLog[]           @relation("AuditLogActor")
}

/// Associação N:N utilizador → farmácias para perfis com acesso a
/// múltiplas (ex: GESTOR_GRUPO, GESTOR_FARMACIA com mais do que uma).
/// Pode ser ignorado quando `Utilizador.perfil = ADMINISTRADOR`, que
/// por contrato tem acesso a TODAS as farmácias.
model UtilizadorFarmacia {
  id           String   @id @default(cuid())
  utilizadorId String
  farmaciaId   String
  dataCriacao  DateTime @default(now())

  utilizador Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  farmacia   Farmacia   @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([utilizadorId, farmaciaId])
  @@index([farmaciaId])
}

/// Auditoria básica — regista acções relevantes do utilizador.
/// Fica propositadamente genérico (string action + JSON meta) para
/// não acoplar a um domínio específico. Chamar `logAudit(...)` do
/// server-side quando uma acção precisa ser rastreável.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  metaJson  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor Utilizador? @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

//////////////////////////////////////////////////////
// PRODUTO POR FARMÁCIA
//////////////////////////////////////////////////////

/// Tudo o que varia entre farmácias vive aqui.
model ProdutoFarmacia {
  id                   String    @id @default(cuid())
  produtoId            String
  farmaciaId           String
  /// Denormalizado do `Produto.externalProductId` para lookups rápidos
  /// do agent sem join (ex: stock-upload precisa de mapear CodigoID →
  /// produtoId em batch). Atualizado pelo endpoint /bootstrap/products.
  externalProductId    Int?
  designacaoLocal      String?
  pvp                  Decimal?  @db.Decimal(12, 4)
  pmc                  Decimal?  @db.Decimal(12, 4)
  puc                  Decimal?  @db.Decimal(12, 4)
  stockAtual           Decimal?  @db.Decimal(14, 3)
  stockRaw             Decimal?  @db.Decimal(14, 3)
  stockMinimo          Decimal?  @db.Decimal(14, 3)
  stockMaximo          Decimal?  @db.Decimal(14, 3)
  /// Stock em encomenda (Softreis: ArmazensStocks.[Existencia Encomenda]).
  /// Soma per-produto across armazéns na ingestão bootstrap.
  stockEncomenda       Decimal?  @db.Decimal(14, 3)
  /// Stock reservado (Softreis: ArmazensStocks.[Existencia Reserva]).
  stockReserva         Decimal?  @db.Decimal(14, 3)
  fornecedorHabitualId String?
  /// ID do fornecedor habitual no ERP da farmácia (Softreis:
  /// ArmazensStocks.[Fornecedor Habitual]). Raw, sem resolução para
  /// Fornecedor.id — utilizado apenas para audit/debug do bootstrap.
  fornecedorExternalId Int?
  dataUltimaVenda      DateTime?
  dataUltimaCompra     DateTime?
  validadeMaisAntiga   DateTime?
  flagRetirado         Boolean   @default(false)
  modeloGestaoStock    String?
  familiaOrigem        String?
  categoriaOrigem      String?
  subcategoriaOrigem   String?
  /// Fornecedor/distribuidor habitual da farmácia (NÃO é o fabricante real
  /// do produto — é o grossista que vende o produto à farmácia: Empifarma,
  /// OCP, Alliance, etc.). Usado apenas como contexto interno, análise de
  /// abastecimento e hints fracos. NUNCA como fabricante canónico.
  fornecedorOrigem     String?
  dataAtualizacao      DateTime  @updatedAt
  dataCriacao          DateTime  @default(now())

  produto            Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  farmacia           Farmacia    @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  fornecedorHabitual Fornecedor? @relation(fields: [fornecedorHabitualId], references: [id])

  @@unique([produtoId, farmaciaId])
  @@index([farmaciaId])
  @@index([produtoId])
  @@index([farmaciaId, externalProductId])
  @@index([fornecedorHabitualId])
  @@index([flagRetirado])
}

//////////////////////////////////////////////////////
// PRODUTOS INTERNOS
//////////////////////////////////////////////////////

/// Produtos internos/localizados apenas na farmácia.
model ProdutoInterno {
  id              String   @id @default(cuid())
  farmaciaId      String
  codigoInterno   Int
  designacao      String?
  tipoArtigo      String?
  pvp             Decimal? @db.Decimal(12, 4)
  puc             Decimal? @db.Decimal(12, 4)
  stockAtual      Decimal? @db.Decimal(14, 3)
  flagRetirado    Boolean  @default(false)
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt
  loteIngestaoId  String?

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  ajustesStock     AjusteStock[]
  linhasInventario LinhaInventario[]

  @@unique([farmaciaId, codigoInterno])
  @@index([farmaciaId])
  @@index([codigoInterno])
}

//////////////////////////////////////////////////////
// DADOS TRANSACIONAIS
//////////////////////////////////////////////////////

/// Vendas diárias agregadas por produto-dia-farmácia.
model Venda {
  id                   String     @id @default(cuid())
  farmaciaId           String
  produtoId            String
  data                 DateTime
  quantidade           Decimal    @db.Decimal(14, 3)
  valorTotal           Decimal    @db.Decimal(14, 2)
  valorUnitario        Decimal?   @db.Decimal(12, 4)
  custoUnitario        Decimal?   @db.Decimal(12, 4)
  tipoVenda            TipoVenda?
  valorComparticipacao Decimal?   @db.Decimal(14, 2)
  valorPagoUtente      Decimal?   @db.Decimal(14, 2)
  numeroTransacoes     Int?
  dataIngestao         DateTime   @default(now())
  loteIngestaoId       String?

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  @@index([farmaciaId, data])
  @@index([produtoId, data])
  @@index([farmaciaId, produtoId, data])
  @@index([loteIngestaoId])
}

/// Vendas mensais agregadas. Granularidade canónica:
/// `(farmaciaId, produtoId, ano, mes)`.
///
/// Fontes possíveis (campo `origemAgregacao`):
///   · "agent-bootstrap-staging"  — agregação server-side de
///     IngestVendaLinhaRaw via `scripts/aggregate-vendamensal.ts`
///   · null / legado              — import Excel ou outras fontes
///     pré-aggregation script (legacy)
///
/// Campos legados (`quantidade`, `valorTotal`, `mesCompleto`,
/// `origemBootstrap`, `dataAtualizacao`, `loteIngestaoId`)
/// preservados para compatibilidade com loaders e dashboards
/// existentes — `aggregate-vendamensal.ts` populá-os a partir dos
/// novos campos para que o dashboard continue intacto.
model VendaMensal {
  id              String   @id @default(cuid())
  farmaciaId      String
  produtoId       String
  ano             Int
  mes             Int

  // ── Campos legados (NOT NULL, populados por loaders Excel + agg script)
  quantidade      Decimal  @db.Decimal(14, 3)
  valorTotal      Decimal  @db.Decimal(14, 2)
  mesCompleto     Boolean  @default(true)
  origemBootstrap Boolean  @default(false)
  dataAtualizacao DateTime @updatedAt
  loteIngestaoId  String?

  // ── Campos da agregação (nullable até script popular) ──────────────
  /// SUM assinado de quantidade (VENDA=+, DEVOLUCAO_ANULACAO=−).
  quantidadeLiquida    Decimal? @db.Decimal(14, 3)
  /// SUM assinado de pvpUnitario × quantidade. "Bruto" = teto comercial.
  valorBruto           Decimal? @db.Decimal(14, 2)
  /// SUM assinado de valorLinha (semântica observada: pago utente).
  valorPagoUtente      Decimal? @db.Decimal(14, 2)
  /// SUM assinado de comparticipacao1 + comparticipacao2.
  valorComparticipado  Decimal? @db.Decimal(14, 2)
  /// COUNT(*) de linhas que compuseram a agregação.
  linhasVenda          Int?
  /// COUNT(DISTINCT externalSaleId) — número de atendimentos distintos.
  atendimentos         Int?
  /// Marcador da origem da agregação. Permite distinguir rows
  /// agregadas server-side de rows legadas Excel-import.
  origemAgregacao      String?
  /// Timestamp da primeira escrita do row (separa criação de actualização).
  createdAt            DateTime @default(now())

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  @@unique([farmaciaId, produtoId, ano, mes])
  @@index([ano, mes])
  @@index([farmaciaId, ano, mes])
  @@index([produtoId, ano, mes])
  @@index([origemAgregacao])
}

/// Compras diárias agregadas por produto-dia-farmácia-fornecedor.
model Compra {
  id                  String   @id @default(cuid())
  farmaciaId          String
  produtoId           String
  fornecedorId        String?
  data                DateTime
  quantidade          Decimal  @db.Decimal(14, 3)
  valorTotal          Decimal  @db.Decimal(14, 2)
  precoUnitario       Decimal? @db.Decimal(12, 4)
  descontoBonificacao Decimal? @db.Decimal(14, 2)
  numeroDocumento     String?
  dataIngestao        DateTime @default(now())
  loteIngestaoId      String?

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedor   Fornecedor?   @relation("CompraFornecedor", fields: [fornecedorId], references: [id])
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  @@index([farmaciaId, data])
  @@index([produtoId, data])
  @@index([fornecedorId])
  @@index([farmaciaId, produtoId, data])
  @@index([loteIngestaoId])
}

/// Devoluções diárias.
model Devolucao {
  id                  String        @id @default(cuid())
  farmaciaId          String
  produtoId           String
  data                DateTime
  quantidade          Decimal       @db.Decimal(14, 3)
  valor               Decimal       @db.Decimal(14, 2)
  tipo                TipoDevolucao
  motivo              String?
  fornecedorDestinoId String?
  dataIngestao        DateTime      @default(now())
  loteIngestaoId      String?

  farmacia          Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto           Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorDestino Fornecedor?   @relation("DevolucaoFornecedorDestino", fields: [fornecedorDestinoId], references: [id])
  loteIngestao      LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  @@index([farmaciaId, data])
  @@index([produtoId, data])
  @@index([tipo])
  @@index([fornecedorDestinoId])
  @@index([loteIngestaoId])
}

/// Histórico periódico de stock por produto-farmácia.
model HistoricoStock {
  id             String   @id @default(cuid())
  farmaciaId     String
  produtoId      String
  dataFotografia DateTime
  quantidade     Decimal  @db.Decimal(14, 3)
  valorCusto     Decimal? @db.Decimal(14, 2)
  loteIngestaoId String?

  farmacia     Farmacia      @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  loteIngestao LoteIngestao? @relation(fields: [loteIngestaoId], references: [id])

  @@unique([farmaciaId, produtoId, dataFotografia])
  @@index([farmaciaId, dataFotografia])
  @@index([produtoId, dataFotografia])
}

//////////////////////////////////////////////////////
// AJUSTES E INVENTÁRIO
//////////////////////////////////////////////////////

/// Ajustes manuais de stock ou correções operacionais.
model AjusteStock {
  id               String          @id @default(cuid())
  farmaciaId       String
  produtoId        String?
  produtoInternoId String?
  data             DateTime
  tipo             TipoAjusteStock
  quantidade       Decimal         @db.Decimal(14, 3)
  valor            Decimal?        @db.Decimal(14, 2)
  motivo           String?
  observacoes      String?
  dataIngestao     DateTime        @default(now())
  loteIngestaoId   String?

  farmacia       Farmacia        @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  produto        Produto?        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoInterno ProdutoInterno? @relation(fields: [produtoInternoId], references: [id], onDelete: Cascade)
  loteIngestao   LoteIngestao?   @relation(fields: [loteIngestaoId], references: [id])

  @@index([farmaciaId, data])
  @@index([produtoId, data])
  @@index([produtoInternoId, data])
  @@index([tipo])
  @@index([loteIngestaoId])
}

/// Cabeçalho de inventário físico da farmácia.
model Inventario {
  id              String           @id @default(cuid())
  farmaciaId      String
  nome            String?
  dataInventario  DateTime
  estado          EstadoInventario @default(RASCUNHO)
  observacoes     String?
  dataCriacao     DateTime         @default(now())
  dataAtualizacao DateTime         @updatedAt
  loteIngestaoId  String?

  farmacia     Farmacia          @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)
  loteIngestao LoteIngestao?     @relation(fields: [loteIngestaoId], references: [id])
  linhas       LinhaInventario[]

  @@index([farmaciaId, dataInventario])
  @@index([estado])
}

/// Linhas do inventário por produto.
model LinhaInventario {
  id               String   @id @default(cuid())
  inventarioId     String
  produtoId        String?
  produtoInternoId String?
  stockSistema     Decimal? @db.Decimal(14, 3)
  stockContado     Decimal  @db.Decimal(14, 3)
  diferenca        Decimal? @db.Decimal(14, 3)
  valorDiferenca   Decimal? @db.Decimal(14, 2)
  observacoes      String?

  inventario     Inventario      @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produto        Produto?        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoInterno ProdutoInterno? @relation(fields: [produtoInternoId], references: [id], onDelete: Cascade)

  @@index([inventarioId])
  @@index([produtoId])
  @@index([produtoInternoId])
}

