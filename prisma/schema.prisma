/// Tipo canónico de um MovimentoArtigo. Derivado de `StocksMov` no
/// SPharm ERP (rev32 audit) por classificador `lib/movimento-classifier.ts`:
///   - FK pattern (qual das 6 colunas FK populadas) → tipo "macro"
///   - texto normalizado do motivo + Cab.[Tipo Documento ID] → sub-tipo
///     interno (INVENTARIO/AJUSTE/QUEBRA/PERDA/TRANSFERENCIA_*)
/// É a representação 1:1 de cada linha StocksMov no SaaS canónico.
enum TipoMovimentoArtigo {
  VENDA
  DEVOLUCAO_CLIENTE
  VENDA_CREDITO
  RESERVA_SUSPENSA
  COMPRA
  DEVOLUCAO_FORNECEDOR
  /// Movimento interno do ERP (origem MovStocksDetID). Operação ÚNICA:
  /// inventário, quebra, validade, uso interno, ValorMed, acerto de
  /// ficha e destruição são todos isto. O motivo do ERP fica em
  /// `movStocksCabMotivoId` / `movStocksCabMotivoTexto` como metadado de
  /// rastreabilidade e não decide lógica operacional nenhuma.
  ACERTO_STOCK
  DESCONHECIDO

  // ── Retirados em rev60 ────────────────────────────────────────
  // Eram inferidos do texto do motivo (escrito pelo operador) e de
  // `cab.[Tipo Documento ID]` (cujos IDs são LOCAIS a cada tenant).
  // Nenhum classificador os volta a produzir; a migração
  // `movimento_interno_acerto_stock` recolhe as linhas existentes para
  // ACERTO_STOCK.
  //
  // Ficam no enum porque Postgres não remove valores de um tipo enum
  // sem o recriar, e recriá-lo obrigaria a reescrever a coluna inteira
  // numa tabela de centenas de milhares de linhas — risco sem retorno.
  // Um valor que ninguém escreve e ninguém lê não custa nada.
  INVENTARIO
  AJUSTE
  QUEBRA
  PERDA
  /// Transferência REAL entre farmácias pertence ao fluxo documental da
  /// Guia de Transferência, que tem contraparte e número de documento —
  /// não a uma inferência sobre um movimento interno.
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SAIDA
}

/// Natureza da contraparte de um MovimentoArtigo. Usada para identificar
/// quem está do outro lado do movimento na grelha "Cliente/Fornecedor"
/// do extrato. Compõe a coluna a partir do FK pattern + JOINs no agent:
///   - CLIENTE          : venda/devolução cliente (Atendimento.Entidades)
///   - FORNECEDOR       : compra/devolução fornecedor (Recepcao/Devolucao_Cab.Fornecedores)
///   - FARMACIA_ORIGEM  : transferência ENTRADA (origem na outra farmácia)
///   - FARMACIA_DESTINO : transferência SAÍDA (destino na outra farmácia)
/// Movimentos internos puros (inventário/quebra/perda/ajuste) ficam com
/// `contraparteTipo = null` e `contraparteNome = null`.
enum ContraparteTipo {
  CLIENTE
  FORNECEDOR
  FARMACIA_ORIGEM
  FARMACIA_DESTINO
}

/// Estados do ciclo de vida de um RegulatoryAcquisitionJob.
/// Transições típicas:
///   PENDING      → IN_PROGRESS    (worker claimed)
///   IN_PROGRESS  → DONE           (todos os campos obtidos)
///   IN_PROGRESS  → PARTIAL        (alguns campos obtidos, retry agendado)
///   IN_PROGRESS  → PENDING        (transient failure, backoff agendado)
///   IN_PROGRESS  → FAILED         (max attempts excedidas)
///   IN_PROGRESS  → BLOCKED        (ambiguidade, requer revisão manual)
///   PARTIAL      → IN_PROGRESS    (worker tenta de novo para completar)
enum AcquisitionJobStatus {
  PENDING
  IN_PROGRESS
  DONE
  PARTIAL
  FAILED
  BLOCKED
}

//////////////////////////////////////////////////////
// CATÁLOGO CENTRAL
//////////////////////////////////////////////////////

/// Produto global do grupo, identificado por CNP.
model Produto {
  id                        String             @id @default(cuid())
  cnp                       Int                @unique
  /// Identificador do produto no ERP da farmácia (Softreis: Stocks.CodigoID).
  /// Mantido como referência cross-tenant — útil para o agent fazer
  /// lookup rápido sem JOIN, MAS não é chave canónica: o ERP pode
  /// reciclar CodigoIDs e produtos diferentes em farmácias diferentes
  /// do mesmo tenant podem partilhar valores (são namespaces locais).
  /// Identidade real do catálogo vive em `cnp @unique`. Index
  /// não-unique para preservar perf de lookups.
  externalProductId         Int?
  designacao                String
  fabricanteId              String?
  classificacaoNivel1Id     String?
  classificacaoNivel2Id     String?
  tipoArtigo                String?
  codigoATC                 String?
  dci                       String?
  imagemUrl                 String?
  formaFarmaceutica         String?
  dosagem                   String?
  embalagem                 String?
  flagGenerico              Boolean            @default(false)
  flagMSRM                  Boolean            @default(false)
  flagMNSRM                 Boolean            @default(false)
  /// MNSRM **não comparticipado** (Softreis: Stocks.MNSRM_NCompart). Distinto
  /// de `flagMNSRM` (OTC); este sinaliza OTC que não tem comparticipação SNS.
  flagMnsrmNCompart         Boolean            @default(false)
  grupoHomogeneo            String?
  estado                    ProdutoEstado      @default(PENDENTE)
  origemDados               ProdutoOrigemDados @default(FARMACIA)
  validadoManualmente       Boolean            @default(false)
  // Classificação e verificação automática
  productType               String?
  productTypeConfidence     Float?
  classificationSource      String?
  classificationVersion     String?
  verificationStatus        VerificationStatus @default(PENDING)
  lastVerifiedAt            DateTime?
  lastVerificationAttemptAt DateTime?
  externallyVerified        Boolean            @default(false)
  needsManualReview         Boolean            @default(false)
  manualReviewReason        String?
  dataCriacao               DateTime           @default(now())
  dataAtualizacao           DateTime           @updatedAt

  fabricante          Fabricante?    @relation(fields: [fabricanteId], references: [id])
  classificacaoNivel1 Classificacao? @relation("ProdutoClassificacaoNivel1", fields: [classificacaoNivel1Id], references: [id])
  classificacaoNivel2 Classificacao? @relation("ProdutoClassificacaoNivel2", fields: [classificacaoNivel2Id], references: [id])

  produtosFarmacia      ProdutoFarmacia[]
  vendas                Venda[]
  vendasMensais         VendaMensal[]
  compras               Compra[]
  devolucoes            Devolucao[]
  historicoStocks       HistoricoStock[]
  ajustesStock          AjusteStock[]
  linhasInventario      LinhaInventario[]
  indicadores           IndicadoresProdutoFarmacia[]
  linhasEncomenda       LinhaEncomenda[]
  filaRevisao           FilaRevisao[]
  filaEnriquecimento    EnriquecimentoFila[]
  verificacaoHistorico  ProdutoVerificacaoHistorico[]
  utilizacoes           ProdutoUtilizacao[]
  enrichmentSourceLogs  EnrichmentSourceLog[]
  ingestVendasLinhasRaw IngestVendaLinhaRaw[]
  movimentos            MovimentoArtigo[]

  @@index([fabricanteId])
  @@index([classificacaoNivel1Id])
  @@index([classificacaoNivel2Id])
  @@index([estado])
  @@index([verificationStatus])
  @@index([productType])
  @@index([lastVerifiedAt])
  @@index([externalProductId])
}

/// Fabricante normalizado.
model Fabricante {
  id              String         @id @default(cuid())
  nomeNormalizado String         @unique
  paisOrigem      String?
  estado          EntidadeEstado @default(ATIVO)
  dataCriacao     DateTime       @default(now())
  dataAtualizacao DateTime       @updatedAt

  aliases  FabricanteAlias[]
  produtos Produto[]
}

/// Variantes de nomes de fabricante encontradas nas origens.
model FabricanteAlias {
  id           String @id @default(cuid())
  fabricanteId String
  aliasNome    String

  fabricante Fabricante @relation(fields: [fabricanteId], references: [id], onDelete: Cascade)

  @@unique([fabricanteId, aliasNome])
  @@index([aliasNome])
}

/// Árvore de classificação central.
model Classificacao {
  id                 String            @id @default(cuid())
  nome               String
  tipo               TipoClassificacao
  classificacaoPaiId String?
  estado             EntidadeEstado    @default(ATIVO)
  ordem              Int?
  dataCriacao        DateTime          @default(now())
  dataAtualizacao    DateTime          @updatedAt

  classificacaoPai  Classificacao?  @relation("ClassificacaoPaiFilho", fields: [classificacaoPaiId], references: [id])
  subClassificacoes Classificacao[] @relation("ClassificacaoPaiFilho")

  produtosNivel1 Produto[] @relation("ProdutoClassificacaoNivel1")
  produtosNivel2 Produto[] @relation("ProdutoClassificacaoNivel2")

  @@unique([nome, tipo, classificacaoPaiId])
  @@index([tipo])
  @@index([classificacaoPaiId])
}

/// Utilização/necessidade — vocabulário CONTROLADO, para pesquisa
/// operacional ao balcão ("produtos para tosse", "dor", "alergias").
///
/// Não é taxonomia. A árvore `Classificacao` responde a "o que é este
/// produto?" e cada produto tem exactamente um lugar nela. Isto responde
/// a "para que serve?", e um produto tem tantas respostas quantas as
/// necessidades que cobre — um xarope pode servir tosse seca e irritação
/// da garganta sem deixar de ser um só artigo num só ramo da árvore.
/// Misturar as duas coisas obrigaria a duplicar produtos na taxonomia ou
/// a inventar subcategorias por sintoma, que é o que se quer evitar.
///
/// Vocabulário fechado: as linhas vêm de `lib/catalog/utilizacoes.ts` e
/// entram por seed. Não há caminho de escrita que crie utilizações a
/// partir de texto do utilizador — sem isso, "tosse", "Tosse" e "p/
/// tosse" viravam três facetas em três meses.
///
/// O `slug` é a chave partilhada entre tenants: cada tenant tem a sua
/// base, mas `tosse` significa o mesmo em todas, e um relatório de grupo
/// pode agregar sem tradução.
model Utilizacao {
  id String @id @default(cuid())

  /// Estável e igual em todos os tenants. Nunca renomear — mudar um slug
  /// desliga as associações que já existem noutras bases.
  slug      String   @unique
  nome      String
  /// Onde acaba esta utilização e começa a seguinte. Serve para quem
  /// classifica decidir sem inventar critério.
  descricao String?
  /// Termos que o operador escreve mas não são o nome canónico
  /// ("expectorante" -> tosse-produtiva). Alimentam a pesquisa.
  sinonimos String[] @default([])

  /// Agrupador só para apresentação (ex.: "Respiratório"). Não é um nível
  /// de hierarquia: nada se pendura por baixo de uma utilização.
  grupo String?

  estado          EntidadeEstado @default(ATIVO)
  ordem           Int?
  dataCriacao     DateTime       @default(now())
  dataAtualizacao DateTime       @updatedAt

  produtos ProdutoUtilizacao[]

  @@index([estado])
  @@index([grupo])
}

/// Produto <-> Utilização. N:N puro, com proveniência.
///
/// A proveniência não é decoração: sem ela, uma associação inferida por
/// regra e uma validada por um farmacêutico ficam indistinguíveis, e a
/// próxima passagem automática sobrescreve a segunda com a primeira.
model ProdutoUtilizacao {
  produtoId    String
  utilizacaoId String

  /// Quem associou: "REGRA", "MANUAL", "ERP", nome do classificador.
  fonte       String
  /// 0–1. NULL quando a origem é manual — uma decisão humana não tem
  /// probabilidade associada.
  confianca   Float?
  dataCriacao DateTime @default(now())

  produto    Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  utilizacao Utilizacao @relation(fields: [utilizacaoId], references: [id], onDelete: Cascade)

  @@id([produtoId, utilizacaoId])
  @@index([utilizacaoId])
  @@index([fonte])
}

/// Fronteira temporal de uma corrida de `products-upload`, medida pelo
/// relógio do SERVIDOR.
///
/// Existe por uma razão só: o sweep que marca produtos como retirados não
/// pode depender do relógio da máquina da farmácia. O agent enviava um
/// `runStartedAt` gerado em Windows, sem NTP garantido; se esse relógio
/// estivesse adiantado, todas as linhas escritas durante a corrida
/// ficavam com `dataAtualizacao` anterior ao corte e o sweep retirava o
/// catálogo inteiro que acabara de ser carregado — com `ok: true`.
///
/// A corrida é aberta pelo próprio servidor no primeiro batch de
/// produtos daquela farmácia, e é `startedAtServer` que serve de corte.
/// O `runStartedAt` do agent continua a viajar no protocolo, mas só como
/// telemetria: nunca entra num WHERE que altere dados.
///
/// Não substitui `PipelineRun` (audit log por farmácia, escrito pelo
/// agent): isto é estado de uma corrida em curso, com um único registo
/// aberto por farmácia de cada vez.
model IngestProdutoRun {
  id         String @id @default(cuid())
  farmaciaId String

  /// O corte. Instante do relógio da base, no primeiro batch da corrida.
  startedAtServer   DateTime @default(now())
  /// Actualizado a cada batch. Serve para detectar corridas abandonadas.
  lastBatchAtServer DateTime @default(now())
  /// Quantos produtos esta corrida entregou. Alimenta a defesa contra
  /// sweeps anormais: uma corrida que entregou 100 linhas não pode
  /// retirar 18 000.
  produtosRecebidos Int      @default(0)

  /// ABERTA | FINALIZADA | ABANDONADA
  estado       String    @default("ABERTA")
  finalizadaEm DateTime?
  /// Quantas linhas o sweep marcou. Null enquanto não finalizou.
  retiradas    Int?

  farmacia Farmacia @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  /// Uma corrida ABERTA por farmácia — garantido pela base e não pela
  /// aplicação, senão dois batches concorrentes criavam duas e o sweep
  /// passava a ter dois cortes possíveis.
  ///
  /// É um índice único PARCIAL (`WHERE estado = 'ABERTA'`), criado na
  /// migração: o Prisma não exprime unicidade condicional, e um
  /// @@unique([farmaciaId, estado]) proibiria duas corridas FINALIZADA
  /// na mesma farmácia, que é precisamente o caso normal.
  @@index([farmaciaId, estado])
  @@index([farmaciaId, startedAtServer])
}

/// Um documento de compra do ERP, com o veredicto sobre se as suas
/// linhas explicam o valor financeiro.
///
/// Derivada de `StagingCompraRawLine`, recalculada a cada agregação.
/// Existe porque a classificação NÃO cabe em `Compra`: essa é agregada
/// por (produto, dia, fornecedor) e pode juntar vários documentos, logo
/// um total documental posto numa linha de `Compra` seria rateio com
/// outro nome — e ratear o total pelas linhas sobreviventes atribuiria
/// a produtos conhecidos o custo de produtos que desapareceram do ERP.
///
/// A investigação (agent rev56) provou que em documentos como o 58865 as
/// linhas em falta não existem em tabela nenhuma: o ERP conserva quanto
/// se pagou e já não conserva por quê.
model CompraDocumento {
  id         String @id @default(cuid())
  farmaciaId String

  /// `Recepcao.[Recepcao ID]`. Identidade do documento no ERP.
  externalReceptionId     Int
  externalTipoDocumentoId Int?
  externalFornecedorId    Int
  externalNRecepcao       Int?
  dataRecepcao            DateTime

  /// `Recepcao.[Total Incidencia_EUR]` — o que o documento vale.
  totalDocumentoEur Decimal @db.Decimal(14, 2)
  /// Σ(quantidade × valorEurUnit) das linhas que ainda existem.
  valorExplicadoEur Decimal @db.Decimal(14, 2)
  /// valorExplicado − totalDocumento. Positivo: linhas somam mais.
  deltaEur          Decimal @db.Decimal(14, 2)
  nLinhas           Int

  /// RECONCILIADA | DETALHE_INCOMPLETO | NAO_FINANCEIRO | SEM_LINHAS.
  /// Texto e não enum: acrescentar uma classe não deve exigir migração
  /// enquanto o domínio ainda está a ser aprendido.
  qualidade String

  /// Batch da agregação que produziu esta linha.
  ingestBatchId String?
  calculadoEm   DateTime @default(now())

  farmacia Farmacia @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([farmaciaId, externalReceptionId])
  @@index([farmaciaId, qualidade])
  @@index([farmaciaId, dataRecepcao])
  @@index([farmaciaId, externalTipoDocumentoId])
}

/// Uma linha por execução de um backfill de catálogo.
///
/// Existe para responder a "estamos a melhorar?" — uma cobertura de 21%
/// não diz nada isolada; 18% → 21% → 37% diz tudo. Sem isto, cada corrida
/// imprime números no terminal e perde-os, e a única forma de comparar é
/// procurar mensagens antigas.
///
/// Não usa PipelineRun: esse é por farmácia e exige `farmaciaId`, e um
/// backfill de catálogo corre sobre o catálogo inteiro do tenant.
model CatalogoBackfillRun {
  id String @id @default(cuid())

  /// Que backfill correu — "utilizacoes", "classificacao", …
  kind        String
  executadoEm DateTime @default(now())

  produtosAnalisados    Int
  produtosClassificados Int
  associacoes           Int
  /// Candidatas que as regras produziram mas ficaram abaixo do limiar.
  /// Contar isto é o que distingue "não há sinal" de "há sinal fraco".
  recusadas             Int

  /// Redundante face aos dois primeiros, mas guardado à mesma: um dia a
  /// definição de "analisado" muda e a série histórica tem de continuar
  /// a ser lida como foi calculada na altura.
  coberturaPercent Float

  /// Limiar em vigor nessa corrida. Sem ele, uma subida de cobertura pode
  /// ser trabalho novo ou apenas o limiar ter descido.
  limiarConfianca Float?
  /// Commit ou revisão das regras, quando conhecido.
  versaoRegras    String?

  /// Detalhe livre: TOP utilizações, recusadas por regra, cobertura por tipo.
  detalhes Json @default("{}")

  @@index([kind, executadoEm])
}

/// Snapshot local do catálogo INFARMED de medicamentos (Portugal).
///
/// Origem: ficheiro descarregado do portal INFARMED (INFOMED / Open Data).
/// Importado por scripts/import-infarmed-snapshot.ts, idempotente por CNP.
///
/// Consultado pelo infarmedConnector em lib/catalog-connectors.ts,
/// que devolve tier=REGULATORY e confidence=0.95 quando há match por CNP.
/// É a primeira fonte autoritária para escrever Produto.fabricanteId / dci / codigoATC.
model InfarmedSnapshot {
  id                String   @id @default(cuid())
  cnp               Int      @unique
  designacaoOficial String
  dci               String?
  codigoATC         String?
  /// Titular da Autorização de Introdução no Mercado — fabricante canónico.
  titularAim        String?
  formaFarmaceutica String?
  dosagem           String?
  embalagem         String?
  grupoTerapeutico  String?
  /// Estado regulamentar: "Autorizado", "Suspenso", "Revogado", "Caducado".
  /// Produtos não-"Autorizado" não são devolvidos pelo conector.
  estadoAim         String?
  /// Identificador do ficheiro/data do snapshot (ex: "2026-04"). Permite
  /// detectar quando uma reimportação trouxe dados mais recentes.
  snapshotVersion   String
  importedAt        DateTime @default(now())

  @@index([snapshotVersion])
  @@index([estadoAim])
}

/// Camada regulatória v2 (Maio 2026). Tabela standalone, indexada por CNP,
/// alimentada pelo importador genérico `scripts/import-regulatory-record.ts`
/// a partir de qualquer fonte (CEDIME/ANF, INFARMED Open Data, listas
/// comparticipados, genéricos, etc.).
///
/// MVP simples — sem provenance per-field, sem versioning multi-source,
/// sem conflict engine. Merge por CNP com regra "preservar não-null":
/// um import só sobrescreve campos já preenchidos quando corrido com `--force`.
///
/// O `infarmedConnector` em `lib/catalog-connectors.ts` lê esta tabela
/// primeiro e cai em `InfarmedSnapshot` quando o CNP não está aqui.
model RegulatoryRecord {
  cnp               Int      @id
  designacaoOficial String?
  dci               String?
  codigoATC         String?
  formaFarmaceutica String?
  dosagem           String?
  embalagem         String?
  grupoTerapeutico  String?
  /// Titular da AIM (fabricante regulatório).
  titularAim        String?
  /// "Autorizado", "Suspenso", "Revogado", "Caducado", etc.
  estadoAim         String?
  /// Tag livre identificando a fonte/import (ex.: "cedime_anf_2026-05",
  /// "infarmed_comparticipados_2026-04"). O último import vence em campos
  /// que sobrescreva.
  source            String
  importedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([codigoATC])
  @@index([dci])
  @@index([source])
  @@index([estadoAim])
}

/// Job da regulatory acquisition pipeline (Phase 0 — Maio 2026).
///
/// Cada produto que precisa de fetch regulatório (DCI, ATC, forma, dosagem,
/// embalagem, titularAim) entra como um job nesta queue. Workers stateless
/// processam jobs em background, tentam fontes externas em ordem de
/// prioridade, e populam `RegulatoryRecord` quando obtêm dados.
///
/// Lifecycle (ver enum AcquisitionJobStatus):
///   PENDING → IN_PROGRESS → { DONE, PARTIAL, FAILED, BLOCKED }
///
/// Worker — `scripts/workers/regulatory-acquisition-worker.ts`:
///   · Claim com FOR UPDATE SKIP LOCKED (safe para múltiplos workers)
///   · Backoff exponencial (1h, 4h, 1d, 3d, 7d) até MAX_ATTEMPTS=6
///   · GC: jobs IN_PROGRESS há > 30min são reset a PENDING (worker crashed)
///
/// Enqueue — `scripts/enqueue-regulatory-acquisition.ts`:
///   · Por CNP / lista de CNPs / cohort predefinido / ficheiro
///   · Upsert com priority configurável
///
/// Phase 0 (esta versão): zero fetchers reais. Worker simula outcome
/// determinístico para validar o lifecycle. Phase 1+ adiciona fetchers
/// (INFARMED Infomed, WHO ATC, manufacturer pages, etc.).
model RegulatoryAcquisitionJob {
  id              String               @id @default(cuid())
  cnp             Int                  @unique
  designacao      String?
  status          AcquisitionJobStatus @default(PENDING)
  /// Prioridade — menor = primeiro. 1=urgente, 50=normal (default), 100=fundo.
  priority        Int                  @default(50)
  attempts        Int                  @default(0)
  /// Última fonte tentada (para diagnóstico): "infarmed_infomed", "manufacturer_page", …
  lastSourceTried String?
  lastError       String?
  lastAttemptAt   DateTime?
  /// Backoff scheduling — jobs só são claimable quando NOW() >= nextAttemptAt.
  nextAttemptAt   DateTime             @default(now())
  /// Lista de campos já populados em RegulatoryRecord para este CNP
  /// (snapshot na altura do último processamento). Usada para evitar
  /// retentar campos já obtidos.
  fieldsObtained  String[]             @default([])
  /// Resumo bruto de cada fonte tentada (debug). Exemplo:
  /// { "infarmed_infomed": { ok: true, fields: ["dci","atc"] },
  ///   "manufacturer_page": { ok: false, reason: "no match" } }
  sourceResults   Json?
  /// Quando atinge status DONE pela primeira vez. Não é actualizado em
  /// re-runs subsequentes.
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, nextAttemptAt])
  @@index([priority, nextAttemptAt])
}

/// Histórico de verificações automáticas por produto.
model ProdutoVerificacaoHistorico {
  id                 String   @id @default(cuid())
  produtoId          String
  verificadoEm       DateTime @default(now())
  productType        String?
  productTypeConf    Float?
  verificationStatus String
  sourceSummary      Json?
  fieldsUpdated      String[]

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, verificadoEm])
}

/// Resultado de cada chamada a um conector externo.
///
/// Granularidade: uma row por (produto × conector × tentativa) — alimenta
/// as métricas de qualidade de fonte em /admin/catalogo E a evidência
/// detalhada em /admin/catalogo/revisao/[id].
///
/// Status:
///   SUCCESS     — match forte; dados extraídos com confiança suficiente.
///   PARTIAL_HIT — página/registo encontrado mas com dados incompletos
///                 ou similaridade média. Útil mostrar ao admin.
///   NO_MATCH    — sem candidato. Conector tentou mas não achou nada.
///   ERROR       — exceção (timeout, HTTP, parse). errorMessage truncada
///                 a 500 chars.
///
/// Append-only. Não há UPDATE; reverify gera nova row.
model EnrichmentSourceLog {
  id             String                 @id @default(cuid())
  produtoId      String
  source         String
  status         EnrichmentSourceStatus
  /// Confiança devolvida pela fonte para este produto. Preenchido em SUCCESS e PARTIAL_HIT.
  confidence     Float?
  /// "cnp" | "sku" | "designacao" | "fuzzy_name" | "ean" | "unknown".
  matchedBy      String?
  durationMs     Int?
  /// Lista de campos não-null devolvidos pela fonte (fabricante, atc, categoria, …).
  /// Permite contar coverage por campo por fonte.
  fieldsReturned String[]
  errorMessage   String?
  /// URL da página/registo de onde os dados vieram, quando aplicável.
  /// Crucial para conectores web (retail_pharmacy) — admin pode abrir a página.
  url            String?
  /// Query exacta enviada à fonte (DDG, OFF/OBF, etc.). Permite reproduzir a busca.
  query          String?
  /// Marca / fabricante exactamente como aparece na fonte, antes de qualquer
  /// normalização. Mostrado ao admin como sinal cru.
  rawBrand       String?
  /// Categoria/breadcrumb cru, antes do mapeamento canónico.
  rawCategory    String?
  /// Nome do produto na fonte (og:title, h1, designacaoOficial, etc.).
  /// Permite ao admin ver se o conector apanhou o produto certo.
  rawProductName String?
  createdAt      DateTime               @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([source, createdAt])
  @@index([produtoId, createdAt])
  @@index([status, createdAt])
}

enum EnrichmentSourceStatus {
  SUCCESS
  NO_MATCH
  ERROR
  PARTIAL_HIT
}

/// Fornecedor normalizado.
///
/// `nomeNormalizado` é canónico GLOBAL no tenant (uma row por fornecedor real).
/// Várias farmácias do mesmo tenant partilham a mesma row de Fornecedor via
/// `FornecedorErpRef` — cada farmácia tem o seu próprio `Fornecedor ID` interno
/// no SPharm local, mas mapeiam para o mesmo Fornecedor canónico SaaS.
///
/// Campos `nome` e `nif` são metadados derivados do ERP (Fornecedores.[Nome
/// Fornecedor] e [Numero Contribuinte]), populados pelo bootstrap de
/// fornecedores. Nullable porque pré-existem rows de Fornecedor criadas por
/// outros fluxos (encomendas, vendas históricas) sem este detalhe.
model Fornecedor {
  id              String         @id @default(cuid())
  nomeNormalizado String         @unique
  /// Nome completo do fornecedor (ex: "MEPHA - INV. DESEN. FAB. F LDA"),
  /// derivado de dbo.Fornecedores.[Nome Fornecedor]. Pode ser igual a
  /// `nomeNormalizado` quando o ERP só tem nome abreviado.
  nome            String?
  /// NIF / Número Contribuinte. Pode ficar NULL — no SPharm Cotovia ~50%
  /// dos fornecedores não têm NIF preenchido. Não usar como chave natural.
  nif             String?
  tipo            FornecedorTipo @default(OUTRO)
  estado          EntidadeEstado @default(ATIVO)
  dataCriacao     DateTime       @default(now())
  dataAtualizacao DateTime       @updatedAt

  aliases                     FornecedorAlias[]
  erpRefs                     FornecedorErpRef[]
  produtosFarmacia            ProdutoFarmacia[]
  compras                     Compra[]                     @relation("CompraFornecedor")
  devolucoesDestino           Devolucao[]                  @relation("DevolucaoFornecedorDestino")
  indicadoresUltimoFornecedor IndicadoresProdutoFarmacia[] @relation("IndicadorUltimoFornecedor")
  linhasEncomenda             LinhaEncomenda[]             @relation("LinhaEncomendaFornecedorSugerido")
}

/// Variantes de nomes de fornecedor.
model FornecedorAlias {
  id           String @id @default(cuid())
  fornecedorId String
  aliasNome    String

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, aliasNome])
  @@index([aliasNome])
}

/// Link per-farmácia ↔ Fornecedor canónico, com snapshot dos metadados do
/// ERP local no momento da última sync. Permite idempotência
/// `(farmaciaId, externalFornecedorId)` mantendo o `Fornecedor` canónico
/// partilhável entre farmácias do mesmo tenant.
///
/// Source: dbo.Fornecedores (Softreis) + LEFT JOIN a Tbl_Tipo_Fornecedores
/// para denormalizar a descrição do tipo.
model FornecedorErpRef {
  id                    String   @id @default(cuid())
  fornecedorId          String
  farmaciaId            String
  /// Valor de dbo.Fornecedores.[Fornecedor ID] no SPharm local desta farmácia.
  externalFornecedorId  Int
  /// Snapshot dos campos do ERP (auditoria + re-derivação).
  nomeAbreviadoErp      String
  nomeFornecedorErp     String?
  nifErp                String?
  tipoFornecedorErpId   Int?
  tipoFornecedorErpDesc String?
  inactivoErp           Boolean  @default(false)
  /// Última vez que esta ref foi tocada pelo agent (UPSERT).
  lastSyncedAt          DateTime @default(now()) @updatedAt
  /// Batch ULID emitido pelo agent na sync. Útil para reconciliação de
  /// "que linhas vieram nesta passagem?".
  ingestBatchId         String?

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  farmacia   Farmacia   @relation(fields: [farmaciaId], references: [id], onDelete: Cascade)

  @@unique([farmaciaId, externalFornecedorId])
  @@index([fornecedorId])
  @@index([farmaciaId, inactivoErp])
  @@index([farmaciaId, lastSyncedAt])
}

//////////////////////////////////////////////////////
// ESTRUTURA MULTI-FARMÁCIA
